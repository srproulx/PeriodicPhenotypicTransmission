Cell[CellGroupData[{

Cell["Compact form", "Subsubsection",ExpressionUUID->"ff853925-6b42-4b0d-b1cd-b9bf2345e14e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"short", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"lambda2", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"h", "^", 
          RowBox[{"(", 
           RowBox[{"2", "*", "k"}], ")"}]}], "->", 
         RowBox[{"u", "^", "2"}]}], ",", 
        RowBox[{
         RowBox[{"h", "^", "k"}], "->", "u"}]}], "}"}]}], ",", 
     RowBox[{"assumptions", "&&", 
      RowBox[{"Element", "[", 
       RowBox[{"u", ",", "Reals"}], "]"}], "&&", 
      RowBox[{
       RowBox[{"-", "1"}], "<", "u", "<", "1"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"compact", "=", 
   RowBox[{
    RowBox[{"Collect", "[", 
     RowBox[{"short", ",", "eta", ",", "Factor"}], "]"}], "/.", 
    RowBox[{"u", "->", 
     RowBox[{"h", "^", "k"}]}]}]}], ";"}], "\n", "compact"}], "Input",
 CellChangeTimes->{{4.0002546725967393`*^9, 4.000254690904974*^9}},
 CellLabel->
  "In[103]:=",ExpressionUUID->"abebbfe8-9491-44f0-967e-62ffb28b2eb6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "2"}], " ", 
   SuperscriptBox["eta", "2"], " ", "q2"}], "+", 
  FractionBox[
   RowBox[{"4", " ", 
    SuperscriptBox["eta", "4"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"4", " ", "h"}], "-", 
      RowBox[{"4", " ", 
       SuperscriptBox["h", 
        RowBox[{"1", "+", "k"}]]}], "-", "k", "+", 
      RowBox[{
       SuperscriptBox["h", "2"], " ", "k"}], "-", 
      RowBox[{
       SuperscriptBox["h", "k"], " ", "k"}], "+", 
      RowBox[{
       SuperscriptBox["h", 
        RowBox[{"2", "+", "k"}]], " ", "k"}]}], ")"}], " ", 
