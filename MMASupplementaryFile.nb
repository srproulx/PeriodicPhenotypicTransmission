Cell[CellGroupData[{

Cell["Mutual information", "Section",ExpressionUUID->"30631bbb-b598-45ea-85e3-c40c646868c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"periodicPhenotypeCycle", "[", 
     RowBox[{"params_List", ",", 
      RowBox[{"etaValue_", "?", "NumericQ"}], ",", "k_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "m", ",", "eigensystem", ",", "index", ",", "state", ",", "env", ",", 
        "states", ",", "pairedEnv", ",", "b"}], "}"}], ",", 
      RowBox[{
       RowBox[{"m", "=", 
        RowBox[{"N", "[", 
         RowBox[{"cycleMatrix", "[", 
          RowBox[{
           RowBox[{"Sequence", "@@", "params"}], ",", "etaValue", ",", "k"}], 
          "]"}], "]"}]}], ";", 
       RowBox[{"eigensystem", "=", 
        RowBox[{"Eigensystem", "[", 
         RowBox[{"Transpose", "[", "m", "]"}], "]"}]}], ";", 
       RowBox[{"index", "=", 
        RowBox[{"First", "[", 
         RowBox[{"Ordering", "[", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{
            "eigensystem", "\[LeftDoubleBracket]", "1", 
             "\[RightDoubleBracket]"}], "]"}], ",", 
           RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", 
       RowBox[{"state", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"eigensystem", "\[LeftDoubleBracket]", 
           RowBox[{"2", ",", "index"}], "\[RightDoubleBracket]"}], "]"}], 
         "]"}]}], ";", 
       RowBox[{"state", "=", 
        FractionBox["state", 
         RowBox[{"Total", "[", "state", "]"}]]}], ";", 
       RowBox[{"b", "=", 
        RowBox[{"transmissionMatrix", "[", 
         RowBox[{
          RowBox[{
          "params", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
          ",", 
          RowBox[{
          "params", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], 
         "]"}]}], ";", 
       RowBox[{"env", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", "k"}], "]"}], ",", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"2", ",", "k"}], "]"}]}], "]"}]}], ";", 
       RowBox[{"states", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"state", "=", 
            RowBox[{"state", ".", 
             RowBox[{"selectionMatrix", "[", 
              RowBox[{"e", ",", 
               RowBox[{
               "params", "\[LeftDoubleBracket]", "1", 
                "\[RightDoubleBracket]"}], ",", 
               RowBox[{
               "params", "\[LeftDoubleBracket]", "2", 
                "\[RightDoubleBracket]"}], ",", "etaValue"}], "]"}], ".", 
             "b"}]}], ";", 
           RowBox[{"state", "=", 
            FractionBox["state", 
             RowBox[{"Total", "[", "state", "]"}]]}], ";", "state"}], ",", 
          RowBox[{"{", 
           RowBox[{"e", ",", "env"}], "}"}]}], "]"}]}], ";", 
       RowBox[{"pairedEnv", "=", 
        RowBox[{"RotateLeft", "[", "env", "]"}]}], ";", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Environment\>\"", "\[Rule]", "pairedEnv"}], ",", 
         RowBox[{"\"\<PhenotypeFrequencies\>\"", "\[Rule]", "states"}]}], 
        "|>"}]}]}], "]"}]}], ";", 
   RowBox[{
    RowBox[{"mutualInformation", "[", 
     RowBox[{"params_List", ",", 
      RowBox[{"etaValue_", "?", "NumericQ"}], ",", "k_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "cycle", ",", "env", ",", "states", ",", "joint", ",", "pEnv", ",", 
        "pPhen", ",", "term"}], "}"}], ",", 
      RowBox[{
       RowBox[{"cycle", "=", 
        RowBox[{"periodicPhenotypeCycle", "[", 
         RowBox[{"params", ",", "etaValue", ",", "k"}], "]"}]}], ";", 
       RowBox[{"env", "=", 
        RowBox[{"cycle", "[", "\"\<Environment\>\"", "]"}]}], ";", 
       RowBox[{"states", "=", 
        RowBox[{"cycle", "[", "\"\<PhenotypeFrequencies\>\"", "]"}]}], ";", 
       RowBox[{"joint", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                 "env", "\[LeftDoubleBracket]", "t", 
                  "\[RightDoubleBracket]"}], "\[Equal]", "e"}], ",", 
                RowBox[{"states", "\[LeftDoubleBracket]", 
                 RowBox[{"t", ",", "i"}], "\[RightDoubleBracket]"}], ",", 
                "0"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", 
                RowBox[{"Length", "[", "env", "]"}]}], "}"}]}], "]"}], "]"}], 
           
           RowBox[{"Length", "[", "env", "]"}]], ",", 
          RowBox[{"{", 
           RowBox[{"e", ",", "1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";", 
       RowBox[{"pEnv", "=", 
        RowBox[{"Total", "/@", "joint"}]}], ";", 
       RowBox[{"pPhen", "=", 
        RowBox[{"Total", "[", "joint", "]"}]}], ";", 
       RowBox[{
        RowBox[{"term", "[", 
         RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"x", "\[LessEqual]", "0"}], ",", "0", ",", 
          RowBox[{"x", " ", 
           RowBox[{"Log", "[", 
            RowBox[{"2", ",", 
             FractionBox["x", "y"]}], "]"}]}]}], "]"}]}], ";", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"term", "[", 
          RowBox[{
           RowBox[{"joint", "\[LeftDoubleBracket]", 
            RowBox[{"e", ",", "i"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{
            "pEnv", "\[LeftDoubleBracket]", "e", "\[RightDoubleBracket]"}], 
            " ", 
            RowBox[{
            "pPhen", "\[LeftDoubleBracket]", "i", 
             "\[RightDoubleBracket]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"e", ",", "1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}]}]}], "]"}]}], ";", 
   RowBox[{
    RowBox[{"binaryEntropy", "[", 
     RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "\[LessEqual]", "0"}], "\[Or]", 
       RowBox[{"x", "\[GreaterEqual]", "1"}]}], ",", "0", ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"x", " ", 
         FractionBox[
          RowBox[{"Log", "[", "x", "]"}], 
          RowBox[{"Log", "[", "2", "]"}]]}]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "x"}], ")"}], " ", 
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", 
          RowBox[{"1", "-", "x"}]}], "]"}]}]}]}], "]"}]}], ";", 
   RowBox[{
    RowBox[{"maximumInformation", "[", "k_Integer", "]"}], ":=", 
    RowBox[{"1", "-", 
     RowBox[{"binaryEntropy", "[", 
      FractionBox["1", "k"], "]"}]}]}], ";", 
   RowBox[{
    RowBox[{"relativeInformation", "[", 
     RowBox[{"params_List", ",", 
      RowBox[{"etaValue_", "?", "NumericQ"}], ",", "k_Integer"}], "]"}], ":=", 
    FractionBox[
     RowBox[{"mutualInformation", "[", 
      RowBox[{"params", ",", "etaValue", ",", "k"}], "]"}], 
     RowBox[{"maximumInformation", "[", "k", "]"}]]}]}], ";"}]], "Input",
 CellLabel->
  "In[267]:=",ExpressionUUID->"32d11664-e3f7-47df-a971-29ec48d7e135"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Evolutionary simulation", "Section",ExpressionUUID->"5b81178a-f1cf-48e3-b2b7-5ad73421832a"],

Cell["\<\
The phenotype coordinates use the shifted logit Log[(1+z)/(1-z)] with inverse \
2/(1+Exp[-x])-1. Retention probabilities continue to use the ordinary 0-to-1 \
logit. No rescaled phenotype vector is introduced. Because the new phenotype \
coordinate is twice as wide, the two phenotype components of the evolutionary \
gradient are multiplied by two for update ranking, convergence, and step \
size; this keeps those numerical operations invariant to the change of \
coordinates.\
\>", "Text",ExpressionUUID->"ba91bc0f-603b-468f-9201-56674098aa82"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"logit", "[", 
     RowBox[{
      RowBox[{"x_", "?", "NumericQ"}], ",", "index_Integer"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"index", "\[LessEqual]", "2"}], ",", 
      RowBox[{"Log", "[", 
       FractionBox[
        RowBox[{"1", "+", "x"}], 
        RowBox[{"1", "-", "x"}]], "]"}], ",", 
      RowBox[{"Log", "[", 
       FractionBox["x", 
        RowBox[{"1", "-", "x"}]], "]"}]}], "]"}]}], ";", 
   RowBox[{
    RowBox[{"invLogit", "[", 
     RowBox[{
      RowBox[{"x_", "?", "NumericQ"}], ",", "index_Integer"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"index", "\[LessEqual]", "2"}], ",", 
      RowBox[{
       FractionBox["2", 
        RowBox[{"1", "+", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "x"}], "]"}]}]], "-", "1"}], ",", 
      FractionBox["1", 
       RowBox[{"1", "+", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", "x"}], "]"}]}]]}], "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[268]:=",ExpressionUUID->"4d9e9f39-8097-492f-9e89-15d22df308c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"simulateTrajectory", "[", 
    RowBox[{"k_Integer", ",", 
     RowBox[{"etaValue_", "?", "NumericQ"}], ",", "initialParameters_List", 
     ",", 
     RowBox[{"tolerance_", ":", 
      FractionBox["1", 
       SuperscriptBox["10", "4"]]}], ",", 
     RowBox[{"stepSize_", ":", "1.`"}], ",", 
     RowBox[{"maxSteps_Integer", ":", "10000"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"params", "=", 
        RowBox[{"N", "[", "initialParameters", "]"}]}], ",", "gradFun", ",", 
       "lamFun", ",", "grad", ",", "effectiveGradient", ",", "index", ",", 
       RowBox[{"records", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"step", "=", "0"}], ",", "lam", ",", "info", ",", 
       "maxGradient"}], "}"}], ",", 
     RowBox[{
      RowBox[{"gradFun", "=", 
       RowBox[{"gradientCompiled", "[", "k", "]"}]}], ";", 
      RowBox[{"lamFun", "=", 
       RowBox[{"lambdaCompiled", "[", "k", "]"}]}], ";", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"step", "\[LessEqual]", "maxSteps"}], ",", 
        RowBox[{
         RowBox[{"grad", "=", 
          RowBox[{"N", "[", 
           RowBox[{"gradFun", "@@", 
            RowBox[{"Join", "[", 
             RowBox[{"params", ",", 
              RowBox[{"{", "etaValue", "}"}]}], "]"}]}], "]"}]}], ";", 
         RowBox[{"effectiveGradient", "=", 
          RowBox[{"grad", " ", 
           RowBox[{"{", 
            RowBox[{"2.`", ",", "2.`", ",", "1.`", ",", "1.`"}], "}"}]}]}], 
         ";", 
         RowBox[{"lam", "=", 
          RowBox[{"N", "[", 
           RowBox[{"lamFun", "@@", 
            RowBox[{"Join", "[", 
             RowBox[{"params", ",", 
              RowBox[{"{", "etaValue", "}"}]}], "]"}]}], "]"}]}], ";", 
         RowBox[{"info", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"k", ">", "2"}], ",", 
            RowBox[{"N", "[", 
             RowBox[{"relativeInformation", "[", 
              RowBox[{"params", ",", "etaValue", ",", "k"}], "]"}], "]"}], 
            ",", "Indeterminate"}], "]"}]}], ";", 
         RowBox[{"maxGradient", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "effectiveGradient", "]"}], "]"}]}], ";", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"records", ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", "step", "}"}], ",", "params", ",", 
             RowBox[{"{", 
              RowBox[{"lam", ",", 
               RowBox[{"Norm", "[", "effectiveGradient", "]"}], ",", "info"}],
               "}"}]}], "]"}]}], "]"}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"maxGradient", "\[LessEqual]", "tolerance"}], "\[Or]", 
            RowBox[{"step", "\[Equal]", "maxSteps"}]}], ",", 
           RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
         RowBox[{"index", "=", 
          RowBox[{"First", "[", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "effectiveGradient", "]"}], ",", 
             RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", 
         RowBox[{
          RowBox[{
          "params", "\[LeftDoubleBracket]", "index", 
           "\[RightDoubleBracket]"}], "=", 
          RowBox[{"invLogit", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"logit", "[", 
              RowBox[{
               RowBox[{
               "params", "\[LeftDoubleBracket]", "index", 
                "\[RightDoubleBracket]"}], ",", "index"}], "]"}], "+", 
             RowBox[{"stepSize", " ", 
              RowBox[{
              "effectiveGradient", "\[LeftDoubleBracket]", "index", 
               "\[RightDoubleBracket]"}]}]}], ",", "index"}], "]"}]}], ";", 
         RowBox[{"step", "++"}], ";", "Null"}]}], "]"}], ";", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Columns\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
          "\"\<Step\>\"", ",", "\"\<z1\>\"", ",", "\"\<z2\>\"", ",", 
           "\"\<beta1\>\"", ",", "\"\<beta2\>\"", ",", "\"\<lambda\>\"", ",", 
           "\"\<EvolutionaryGradientNorm\>\"", ",", 
           "\"\<RelativeInformation\>\""}], "}"}]}], ",", 
        RowBox[{"\"\<Data\>\"", "\[Rule]", "records"}], ",", 
        RowBox[{"\"\<FinalParameters\>\"", "\[Rule]", "params"}], ",", 
        RowBox[{"\"\<Steps\>\"", "\[Rule]", "step"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[269]:=",ExpressionUUID->"cd80f24d-d505-4a6d-a165-160cf741d40e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"makeTrajectoryFigure", "[", 
    RowBox[{"result_Association", ",", "k_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"data", "=", 
        RowBox[{"result", "[", "\"\<Data\>\"", "]"}]}], ",", "phenotypePlot", 
       ",", "memoryPlot", ",", "gradientPlot", ",", "informationPlot"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"phenotypePlot", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"data", "\[LeftDoubleBracket]", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}]}], "\[RightDoubleBracket]"}], 
           ",", 
           RowBox[{"data", "\[LeftDoubleBracket]", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "3"}], "}"}]}], "\[RightDoubleBracket]"}]}], 
          "}"}], ",", 
         RowBox[{"Frame", "\[Rule]", "True"}], ",", 
         RowBox[{"FrameLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Evolutionary step\>\"", ",", "\"\<Phenotypic value\>\""}], 
           "}"}]}], ",", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"All", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"Epilog", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Inset", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<A\>\"", ",", "16", ",", "Bold"}], "]"}], ",", 
             RowBox[{"Scaled", "[", 
              RowBox[{"{", 
               RowBox[{"0.9`", ",", "0.92`"}], "}"}], "]"}]}], "]"}], "}"}]}],
          ",", 
         RowBox[{"ImageSize", "\[Rule]", "380"}]}], "]"}]}], ";", 
      RowBox[{"memoryPlot", "=", 
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"data", "\[LeftDoubleBracket]", 
              RowBox[{"All", ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "4"}], "}"}]}], "\[RightDoubleBracket]"}], 
             ",", 
             RowBox[{"data", "\[LeftDoubleBracket]", 
              RowBox[{"All", ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "5"}], "}"}]}], "\[RightDoubleBracket]"}]}],
             "}"}], ",", 
           RowBox[{"Frame", "\[Rule]", "True"}], ",", 
           RowBox[{"FrameLabel", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
             "\"\<Evolutionary step\>\"", ",", 
              "\"\<Retention probability\>\""}], "}"}]}], ",", 
           RowBox[{"PlotRange", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"All", ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"Epilog", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"Inset", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<B\>\"", ",", "16", ",", "Bold"}], "]"}], ",", 
               RowBox[{"Scaled", "[", 
                RowBox[{"{", 
                 RowBox[{"0.9`", ",", "0.92`"}], "}"}], "]"}]}], "]"}], 
             "}"}]}], ",", 
           RowBox[{"ImageSize", "\[Rule]", "380"}]}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"1", "-", 
            FractionBox["1", "k"]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"First", "[", 
              RowBox[{"data", "\[LeftDoubleBracket]", 
               RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}], "]"}], 
             ",", 
             RowBox[{"Last", "[", 
              RowBox[{"data", "\[LeftDoubleBracket]", 
               RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}], "]"}]}], 
            "}"}], ",", 
           RowBox[{"PlotStyle", "\[Rule]", "Dashed"}]}], "]"}]}], "]"}]}], 
      ";", 
      RowBox[{"gradientPlot", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"data", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "7"}], "}"}]}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"Frame", "\[Rule]", "True"}], ",", 
         RowBox[{"FrameLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Evolutionary step\>\"", ",", "\"\<Log-growth gradient\>\""}], 
           "}"}]}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
         RowBox[{"Epilog", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Inset", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<C\>\"", ",", "16", ",", "Bold"}], "]"}], ",", 
             RowBox[{"Scaled", "[", 
              RowBox[{"{", 
               RowBox[{"0.9`", ",", "0.92`"}], "}"}], "]"}]}], "]"}], "}"}]}],
          ",", 
         RowBox[{"ImageSize", "\[Rule]", "380"}]}], "]"}]}], ";", 
      RowBox[{"informationPlot", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"data", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "8"}], "}"}]}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"Frame", "\[Rule]", "True"}], ",", 
         RowBox[{"FrameLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Evolutionary step\>\"", ",", "\"\<Relative information\>\""}],
            "}"}]}], ",", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"All", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"Epilog", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Inset", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<D\>\"", ",", "16", ",", "Bold"}], "]"}], ",", 
             RowBox[{"Scaled", "[", 
              RowBox[{"{", 
               RowBox[{"0.9`", ",", "0.92`"}], "}"}], "]"}]}], "]"}], "}"}]}],
          ",", 
         RowBox[{"ImageSize", "\[Rule]", "380"}]}], "]"}]}], ";", 
      RowBox[{"GraphicsGrid", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"phenotypePlot", ",", "memoryPlot"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"gradientPlot", ",", "informationPlot"}], "}"}]}], "}"}], 
        ",", 
        RowBox[{"Spacings", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0.5`", ",", "0.5`"}], "}"}]}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "800"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.999193363443202*^9, 3.999193367248044*^9}},
 CellLabel->
  "In[270]:=",ExpressionUUID->"1ac3f72f-920a-4a0f-a972-bf98854c3447"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mainK", "=", "6"}], ";", 
   RowBox[{"mainEtaSquared", "=", "0.75`"}], ";", 
   RowBox[{"mainEta", "=", 
    SqrtBox["mainEtaSquared"]}], ";", 
   RowBox[{"mainInitialParameters", "=", 
    RowBox[{"{", 
     RowBox[{"0.`", ",", "0.1`", ",", "0.99`", ",", "0.01`"}], "}"}]}], ";", 
   RowBox[{"mainTrajectory", "=", 
    RowBox[{"simulateTrajectory", "[", 
     RowBox[{"mainK", ",", "mainEta", ",", "mainInitialParameters", ",", 
      FractionBox["1", 
       SuperscriptBox["10", "4"]], ",", "1.`", ",", "10000"}], "]"}]}], ";", 
   RowBox[{"trajectoryFigure", "=", 
    RowBox[{"makeTrajectoryFigure", "[", 
     RowBox[{"mainTrajectory", ",", "mainK"}], "]"}]}], ";", 
   RowBox[{"Export", "[", 
