Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"etaFromSigma", "[", 
     RowBox[{"s_", "?", "NumericQ"}], "]"}], ":=", 
    FractionBox["1", 
     RowBox[{
      SqrtBox["2"], " ", "s"}]]}], ";", 
   RowBox[{
    RowBox[{"sigmaFromEta", "[", 
     RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
    FractionBox["1", 
     RowBox[{
      SqrtBox["2"], " ", "x"}]]}], ";", 
   RowBox[{
    RowBox[{"zOpt", "[", "1", "]"}], "=", 
    RowBox[{"-", "1"}]}], ";", 
   RowBox[{
    RowBox[{"zOpt", "[", "2", "]"}], "=", "1"}], ";", 
   RowBox[{
    RowBox[{"fitness", "[", 
     RowBox[{"z_", ",", "e_Integer", ",", "eta_"}], "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{
       SuperscriptBox["eta", "2"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"z", "-", 
          RowBox[{"zOpt", "[", "e", "]"}]}], ")"}], "2"]}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"fd346a13-6f25-4625-803f-87ef7129bd6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"transmissionMatrix", "[", 
     RowBox[{"beta1_", ",", "beta2_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"beta1", ",", 
        RowBox[{"1", "-", "beta1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "-", "beta2"}], ",", "beta2"}], "}"}]}], "}"}]}], ";", 
   RowBox[{
    RowBox[{"selectionMatrix", "[", 
     RowBox[{"e_Integer", ",", "z1_", ",", "z2_", ",", "eta_"}], "]"}], ":=", 
    
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fitness", "[", 
        RowBox[{"z1", ",", "e", ",", "eta"}], "]"}], ",", 
       RowBox[{"fitness", "[", 
        RowBox[{"z2", ",", "e", ",", "eta"}], "]"}]}], "}"}], "]"}]}], ";", 
   RowBox[{
    RowBox[{"cycleMatrix", "[", 
     RowBox[{
     "z1_", ",", "z2_", ",", "beta1_", ",", "beta2_", ",", "eta_", ",", 
      "k_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"b", "=", 
         RowBox[{"transmissionMatrix", "[", 
          RowBox[{"beta1", ",", "beta2"}], "]"}]}], ",", "a1", ",", "a2"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"a1", "=", 
        RowBox[{
         RowBox[{"selectionMatrix", "[", 
          RowBox[{"1", ",", "z1", ",", "z2", ",", "eta"}], "]"}], ".", 
         "b"}]}], ";", 
       RowBox[{"a2", "=", 
        RowBox[{
         RowBox[{"selectionMatrix", "[", 
          RowBox[{"2", ",", "z1", ",", "z2", ",", "eta"}], "]"}], ".", 
         "b"}]}], ";", 
       RowBox[{
        RowBox[{"MatrixPower", "[", 
         RowBox[{"a1", ",", "k"}], "]"}], ".", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"a2", ",", "k"}], "]"}]}]}]}], "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"f6bb75c5-64a3-4076-9f0a-22d14b6e04c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dominantEigenvalue2", "[", "m_", "]"}], ":=", 
    FractionBox[
     RowBox[{
      RowBox[{"Tr", "[", "m", "]"}], "+", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"Tr", "[", "m", "]"}], "2"], "-", 
        RowBox[{"4", " ", 
         RowBox[{"Det", "[", "m", "]"}]}]}]]}], "2"]}], ";", 
   RowBox[{
    RowBox[{"lambdaExpression", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"lambdaExpression", "[", "k", "]"}], "=", 
     FractionBox[
      RowBox[{"Log", "[", 
       RowBox[{"dominantEigenvalue2", "[", 
        RowBox[{"cycleMatrix", "[", 
         RowBox[{
         "z1", ",", "z2", ",", "beta1", ",", "beta2", ",", "eta", ",", "k"}], 
         "]"}], "]"}], "]"}], 
      RowBox[{"2", " ", "k"}]]}]}], ";", 
   RowBox[{
    RowBox[{"gradientExpression", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"gradientExpression", "[", "k", "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"lambdaExpression", "[", "k", "]"}], ",", "#1"}], "]"}], 
        "&"}], ")"}], "/@", 
      RowBox[{"{", 
       RowBox[{"z1", ",", "z2", ",", "beta1", ",", "beta2"}], "}"}]}]}]}], 
   ";", 
   RowBox[{
    RowBox[{"secondZ2Expression", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"secondZ2Expression", "[", "k", "]"}], "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"lambdaExpression", "[", "k", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"z2", ",", "2"}], "}"}]}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"z1", "\[Rule]", "0"}], ",", 
        RowBox[{"z2", "\[Rule]", "0"}]}], "}"}]}]}]}]}], ";"}]], "Input",
 CellLabel->
  "In[124]:=",ExpressionUUID->"7cd864e8-cd84-47b5-9d0b-8a656a05d6c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"lambdaCompiled", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"lambdaCompiled", "[", "k", "]"}], "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr", "=", 
         RowBox[{"lambdaExpression", "[", "k", "]"}]}], "}"}], ",", 
       RowBox[{"Compile", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"z1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"z2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"eta", ",", "_Real"}], "}"}]}], "}"}], ",", 
         RowBox[{"Evaluate", "[", "expr", "]"}]}], "]"}]}], "]"}]}]}], ";", 
   RowBox[{
    RowBox[{"gradientCompiled", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"gradientCompiled", "[", "k", "]"}], "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr", "=", 
         RowBox[{"gradientExpression", "[", "k", "]"}]}], "}"}], ",", 
       RowBox[{"Compile", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"z1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"z2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"eta", ",", "_Real"}], "}"}]}], "}"}], ",", 
         RowBox[{"Evaluate", "[", "expr", "]"}]}], "]"}]}], "]"}]}]}], ";", 
   RowBox[{
    RowBox[{"secondZ2Compiled", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"secondZ2Compiled", "[", "k", "]"}], "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr", "=", 
         RowBox[{"secondZ2Expression", "[", "k", "]"}]}], "}"}], ",", 
       RowBox[{"Compile", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"beta1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"eta", ",", "_Real"}], "}"}]}], "}"}], ",", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"Re", "[", "expr", "]"}], "]"}]}], "]"}]}], "]"}]}]}], ";", 
   
   RowBox[{
    RowBox[{"lambdaNumeric", "[", 
     RowBox[{"params_List", ",", 
      RowBox[{"etaValue_", "?", "NumericQ"}], ",", "k_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"m", "=", 
         RowBox[{"N", "[", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}], "]"}]}], ",", 
        "dominantRoot", ",", "b", ",", "a1", ",", "a2", ",", "scale", ",", 
        RowBox[{"logScale", "=", "0.`"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"b", "=", 
        RowBox[{"transmissionMatrix", "[", 
         RowBox[{
          RowBox[{
          "params", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
          ",", 
          RowBox[{
          "params", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], 
         "]"}]}], ";", 
       RowBox[{"a1", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"selectionMatrix", "[", 
           RowBox[{"1", ",", 
            RowBox[{
            "params", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            ",", 
            RowBox[{
            "params", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
            ",", "etaValue"}], "]"}], ".", "b"}], "]"}]}], ";", 
       RowBox[{"a2", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"selectionMatrix", "[", 
           RowBox[{"2", ",", 
            RowBox[{
            "params", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            ",", 
            RowBox[{
            "params", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
            ",", "etaValue"}], "]"}], ".", "b"}], "]"}]}], ";", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"m", "=", 
           RowBox[{"m", ".", "a"}]}], ";", 
          RowBox[{"scale", "=", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Flatten", "[", "m", "]"}], "]"}], "]"}]}], ";", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"TrueQ", "[", 
              RowBox[{"scale", ">", "0.`"}], "]"}]}], ",", 
            RowBox[{"Return", "[", "Indeterminate", "]"}]}], "]"}], ";", 
          RowBox[{"m", "=", 
           FractionBox["m", "scale"]}], ";", 
          RowBox[{"logScale", "+=", 
           RowBox[{"Log", "[", "scale", "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"a1", ",", "k"}], "]"}], ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"a2", ",", "k"}], "]"}]}], "]"}]}], "}"}]}], "]"}], ";", 
       RowBox[{"dominantRoot", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"Eigenvalues", "[", "m", "]"}], "]"}], "]"}]}], ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"dominantRoot", ">", "0.`"}], "]"}]}], ",", 
         RowBox[{"Return", "[", "Indeterminate", "]"}]}], "]"}], ";", 
       FractionBox[
        RowBox[{"logScale", "+", 
         RowBox[{"Log", "[", "dominantRoot", "]"}]}], 
        RowBox[{"2", " ", "k"}]]}]}], "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[125]:=",ExpressionUUID->"7bcb7c1f-9b9f-4f41-a7b8-6724cc14bc10"]
