Cell[CellGroupData[{

Cell["Compare to DME", "Subsection",
 CellChangeTimes->{{3.99857745876331*^9, 
  3.9985774611060257`*^9}},ExpressionUUID->"74a2cc9d-b600-4773-9be8-\
428c8ede1b2e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "dmeLogGrowth", ",", "stateLogGrowth", ",", "dmeComparisonFigure"}], 
    "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"Figure", " ", "parameters"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kValue", "=", "6"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"etaValue", "=", "1"}], ";"}], "          ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"eta", "^", "2"}], "=", "1"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"beta1Value", "=", 
    RowBox[{"5", "/", "6"}]}], ";"}], "       ", 
  RowBox[{"(*", 
   RowBox[{"state", "-", 
    RowBox[{"retention", " ", "probabilities"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"beta2Value", "=", 
   RowBox[{"5", "/", "6"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"epsilonMaximum", "=", "0.5"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lambdaAncestor", "=", 
    RowBox[{"-", 
     RowBox[{"etaValue", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Deterministic", " ", "maternal", " ", 
    RowBox[{"effect", ":", 
     RowBox[{
      RowBox[{"equation", " ", "dme"}], "-", "growth"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dmeLogGrowth", "[", 
     RowBox[{"eps_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"etaValue", "^", "2"}]}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"kValue", "-", "1"}], ")"}], "/", "kValue"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"eps", "/", "2"}]}], ")"}], "^", "2"}]}], "+", 
       RowBox[{
        RowBox[{"1", "/", "kValue"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"eps", "/", "2"}]}], ")"}], "^", "2"}]}]}], ")"}]}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"State", "-", 
    RowBox[{
    "transmission", " ", "mutant", " ", "with", " ", "phenotypes", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"+", "epsilon"}]}], "}"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stateLogGrowth", "[", 
     RowBox[{"eps_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"lambdaNumeric", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "eps"}], "/", "2"}], ",", 
        RowBox[{"eps", "/", "2"}], ",", "beta1Value", ",", "beta2Value"}], 
       "}"}], ",", "etaValue", ",", "kValue"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"dmeColor", "=", 
   RowBox[{"RGBColor", "[", 
    RowBox[{"0.80", ",", "0.20", ",", "0.15"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stateColor", "=", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0.00", ",", "0.45", ",", "0.70"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dmeComparisonFigure", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dmeLogGrowth", "[", "eps", "]"}], ",", 
        RowBox[{"stateLogGrowth", "[", "eps", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"eps", ",", "0", ",", "epsilonMaximum"}], "}"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Phenotypic perturbation, \[Epsilon]\>\"", ",", 
         "\"\<Per-generation log growth, \[Lambda]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"dmeColor", ",", 
           RowBox[{"AbsoluteThickness", "[", "2.5", "]"}]}], "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"stateColor", ",", 
           RowBox[{"AbsoluteThickness", "[", "2.5", "]"}]}], "]"}]}], "}"}]}],
       ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"dmeColor", ",", "stateColor"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
            "\"\<Deterministic maternal effect\>\"", ",", 
             "\"\<State transmission\>\""}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.68", ",", "0.22"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"GridLines", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"{", "lambdaAncestor", "}"}]}], "}"}]}], ",", 
      RowBox[{"GridLinesStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"GrayLevel", "[", "0.5", "]"}], ",", "Dashed"}], "]"}]}], 
      ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"PlotRangePadding", "->", 
       RowBox[{"Scaled", "[", "0.04", "]"}]}], ",", 
      RowBox[{"PlotPoints", "->", "80"}], ",", 
      RowBox[{"MaxRecursion", "->", "2"}], ",", 
      RowBox[{"ImageSize", "->", "430"}], ",", 
      RowBox[{"BaseStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FontFamily", "->", "\"\<Helvetica\>\""}], ",", "12"}], 
        "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dmeComparisonFigure", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"dmeLogGrowth", "[", "eps", "]"}], "]"}], ",", 
        RowBox[{"Exp", "[", 
         RowBox[{"stateLogGrowth", "[", "eps", "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"eps", ",", "0", ",", "epsilonMaximum"}], "}"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Change in phenotype\>\"", ",", "\"\<Fitness\>\""}], 
        "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "430"}], ",", 
      RowBox[{"BaseStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FontFamily", "->", "\"\<Helvetica\>\""}], ",", "12"}], 
        "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"dmeComparisonFigure", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"outputDirectory", ",", "\"\<DMECompare.pdf\>\""}], "}"}], 
     "]"}], ",", "dmeComparisonFigure"}], "]"}], ";"}]}], "Input",
