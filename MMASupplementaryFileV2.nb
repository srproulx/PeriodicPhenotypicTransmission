Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SetDirectory", "[", 
    RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "zOpt", ",", "w", ",", "fitness", ",", "transmissionMatrix", ",", 
     "selectionMatrix", ",", "cycleMatrix", ",", "dominantEigenvalue2", ",", 
     "lambdaExpression", ",", "gradientExpression", ",", "secondZ2Expression",
      ",", "lambdaCompiled", ",", "gradientCompiled", ",", "secondZ2Compiled",
      ",", "lambdaNumeric", ",", "etaFromSigma", ",", "sigmaFromEta", ",", 
     "logit", ",", "invLogit", ",", "periodicPhenotypeCycle", ",", 
     "mutualInformation", ",", "binaryEntropy", ",", "maximumInformation", 
     ",", "relativeInformation", ",", "numericalFirstDerivativeCheck", ",", 
     "firstZDerivativeNumeric", ",", "makeFirstDerivativeSurface", ",", 
     "secondZDerivativeNumeric", ",", "makeSecondDerivativeSurface", ",", 
     "firstDerivativeSurface", ",", "secondDerivativeSurface", ",", 
     "simulateTrajectory", ",", "evolveToEquilibrium", ",", 
     "makeTrajectoryFigure", ",", "makeMemoryRegionPanel"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"okabeIto", "=", 
    RowBox[{"Apply", "[", 
     RowBox[{"RGBColor", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.9", ",", "0.6", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.35", ",", "0.7", ",", "0.9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.6", ",", "0.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.95", ",", "0.9", ",", "0.25"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.45", ",", "0.7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.8", ",", "0.4", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.8", ",", "0.6", ",", "0.7"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"etaFromSigma", "[", 
    RowBox[{"s_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sqrt", "[", "2", "]"}], " ", "s"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sigmaFromEta", "[", 
     RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], " ", "x"}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zOpt", "[", "1", "]"}], "=", 
   RowBox[{"-", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"zOpt", "[", "2", "]"}], "=", "1"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"w", "[", 
     RowBox[{"z_", ",", "e_Integer", ",", "eta_"}], "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"eta", "^", "2"}]}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"z", "-", 
         RowBox[{"zOpt", "[", "e", "]"}]}], ")"}], "^", "2"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"transmissionMatrix", "[", 
     RowBox[{"beta1_", ",", "beta2_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"beta1", ",", 
        RowBox[{"1", "-", "beta1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "-", "beta2"}], ",", "beta2"}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"selectionMatrix", "[", 
     RowBox[{"e_Integer", ",", "z1_", ",", "z2_", ",", "eta_"}], "]"}], ":=", 
    
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"w", "[", 
        RowBox[{"z1", ",", "e", ",", "eta"}], "]"}], ",", 
       RowBox[{"w", "[", 
        RowBox[{"z2", ",", "e", ",", "eta"}], "]"}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cycleMatrix", "[", 
     RowBox[{
     "z1_", ",", "z2_", ",", "beta1_", ",", "beta2_", ",", "eta_", ",", 
      "k_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"b", "=", 
         RowBox[{"transmissionMatrix", "[", 
          RowBox[{"beta1", ",", "beta2"}], "]"}]}], ",", "a1", ",", "a2"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"a1", "=", 
        RowBox[{
         RowBox[{"selectionMatrix", "[", 
          RowBox[{"1", ",", "z1", ",", "z2", ",", "eta"}], "]"}], ".", 
         "b"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"a2", "=", 
        RowBox[{
         RowBox[{"selectionMatrix", "[", 
          RowBox[{"2", ",", "z1", ",", "z2", ",", "eta"}], "]"}], ".", 
         "b"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"MatrixPower", "[", 
         RowBox[{"a1", ",", "k"}], "]"}], ".", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"a2", ",", "k"}], "]"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dominantEigenvalue2", "[", "m_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Tr", "[", "m", "]"}], "+", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Tr", "[", "m", "]"}], "^", "2"}], "-", 
         RowBox[{"4", " ", 
          RowBox[{"Det", "[", "m", "]"}]}]}], "]"}]}], ")"}], "/", "2"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"lambdaExpression", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"lambdaExpression", "[", "k", "]"}], "=", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"dominantEigenvalue2", "[", 
        RowBox[{"cycleMatrix", "[", 
         RowBox[{
         "z1", ",", "z2", ",", "beta1", ",", "beta2", ",", "eta", ",", "k"}], 
         "]"}], "]"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "k"}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gradientExpression", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"gradientExpression", "[", "k", "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"lambdaExpression", "[", "k", "]"}], ",", "#"}], "]"}], 
        "&"}], ")"}], "/@", 
      RowBox[{"{", 
       RowBox[{"z1", ",", "z2", ",", "beta1", ",", "beta2"}], "}"}]}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"secondZ2Expression", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"secondZ2Expression", "[", "k", "]"}], "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"lambdaExpression", "[", "k", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"z2", ",", "2"}], "}"}]}], "]"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"z1", "->", "0"}], ",", 
        RowBox[{"z2", "->", "0"}]}], "}"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"lambdaCompiled", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"lambdaCompiled", "[", "k", "]"}], "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr", "=", 
         RowBox[{"lambdaExpression", "[", "k", "]"}]}], "}"}], ",", 
       RowBox[{"Compile", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"z1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"z2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"eta", ",", "_Real"}], "}"}]}], "}"}], ",", 
         RowBox[{"Evaluate", "[", "expr", "]"}]}], "]"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gradientCompiled", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"gradientCompiled", "[", "k", "]"}], "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr", "=", 
         RowBox[{"gradientExpression", "[", "k", "]"}]}], "}"}], ",", 
       RowBox[{"Compile", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"z1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"z2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"eta", ",", "_Real"}], "}"}]}], "}"}], ",", 
         RowBox[{"Evaluate", "[", "expr", "]"}]}], "]"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"secondZ2Compiled", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"secondZ2Compiled", "[", "k", "]"}], "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr", "=", 
         RowBox[{"secondZ2Expression", "[", "k", "]"}]}], "}"}], ",", 
       RowBox[{"Compile", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"beta1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"eta", ",", "_Real"}], "}"}]}], "}"}], ",", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"Re", "[", "expr", "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lambdaNumeric", "[", 
    RowBox[{"params_List", ",", 
     RowBox[{"etaValue_", "?", "NumericQ"}], ",", "k_Integer"}], "]"}], ":=", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "=", 
        RowBox[{"N", "[", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}], "]"}]}], ",", 
       "dominantRoot", ",", "b", ",", "a1", ",", "a2", ",", "scale", ",", 
       RowBox[{"logScale", "=", "0."}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"b", "=", 
       RowBox[{"transmissionMatrix", "[", 
        RowBox[{
         RowBox[{"params", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"params", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"a1", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"selectionMatrix", "[", 
          RowBox[{"1", ",", 
           RowBox[{"params", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"params", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "etaValue"}], "]"}], ".", 
         "b"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"a2", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"selectionMatrix", "[", 
          RowBox[{"2", ",", 
           RowBox[{"params", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"params", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "etaValue"}], "]"}], ".", 
         "b"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"m", "=", 
          RowBox[{"m", ".", "a"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"scale", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Flatten", "[", "m", "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"TrueQ", "[", 
             RowBox[{"scale", ">", "0."}], "]"}]}], ",", 
           RowBox[{"Return", "[", "Indeterminate", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"m", "=", 
          RowBox[{"m", "/", "scale"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"logScale", "+=", 
          RowBox[{"Log", "[", "scale", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"a1", ",", "k"}], "]"}], ",", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"a2", ",", "k"}], "]"}]}], "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dominantRoot", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"Eigenvalues", "[", "m", "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"dominantRoot", ">", "0."}], "]"}]}], ",", 
        RowBox[{"Return", "[", "Indeterminate", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"logScale", "+", 
         RowBox[{"Log", "[", "dominantRoot", "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "k"}], ")"}]}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.000557689894229*^9, 4.00055768989671*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"b4656d16-fa6d-4b12-acba-5b278fa38b31"]
}, Closed]],

Cell[CellGroupData[{

Cell["Compare to DME", "Subsection",
 CellChangeTimes->{{3.99857745876331*^9, 
  3.9985774611060257`*^9}},ExpressionUUID->"b76bccee-7832-4653-ad69-\
2f3abe863d50"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kValue", "=", "6"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"etaValue", "=", "1"}], ";"}], "          "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"beta1Value", "=", 
    RowBox[{"5", "/", "6"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"beta2Value", "=", 
   RowBox[{"5", "/", "6"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"epsilonMaximum", "=", "0.5"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lambdaAncestor", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"w", "[", 
         RowBox[{"0", ",", "1", ",", "etaValue"}], "]"}], "]"}], "+", 
       RowBox[{"Log", "[", 
        RowBox[{"w", "[", 
         RowBox[{"0", ",", "2", ",", "etaValue"}], "]"}], "]"}]}], ")"}], "/",
      "2"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Deterministic", " ", "maternal", " ", "effect"}], ",", 
    RowBox[{"with", " ", "phenotypes", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "eps"}], "/", "2"}], ",", 
       RowBox[{
        RowBox[{"+", "eps"}], "/", "2"}]}], "}"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dmeLogGrowth", "[", 
     RowBox[{"eps_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"kValue", "-", "1"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "kValue"}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"w", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "eps"}], "/", "2"}], ",", "1", ",", "etaValue"}], 
          "]"}], "]"}], "+", 
        RowBox[{"Log", "[", 
         RowBox[{"w", "[", 
          RowBox[{
           RowBox[{"eps", "/", "2"}], ",", "2", ",", "etaValue"}], "]"}], 
         "]"}]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "kValue"}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"w", "[", 
          RowBox[{
           RowBox[{"eps", "/", "2"}], ",", "1", ",", "etaValue"}], "]"}], 
         "]"}], "+", 
        RowBox[{"Log", "[", 
         RowBox[{"w", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "eps"}], "/", "2"}], ",", "2", ",", "etaValue"}], 
          "]"}], "]"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"State", "-", 
     RowBox[{"transmission", " ", "mutant"}]}], ",", 
    RowBox[{"with", " ", "phenotypes", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "eps"}], "/", "2"}], ",", 
       RowBox[{
        RowBox[{"+", "eps"}], "/", "2"}]}], "}"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stateLogGrowth", "[", 
     RowBox[{"eps_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"lambdaNumeric", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "eps"}], "/", "2"}], ",", 
        RowBox[{"eps", "/", "2"}], ",", "beta1Value", ",", "beta2Value"}], 
       "}"}], ",", "etaValue", ",", "kValue"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"dmeColor", "=", 
   RowBox[{"RGBColor", "[", 
    RowBox[{"0.80", ",", "0.20", ",", "0.15"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stateColor", "=", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0.00", ",", "0.45", ",", "0.70"}], "]"}]}], ";"}], "\n", "\n", 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"dmeComparisonFigure", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"dmeLogGrowth", "[", "eps", "]"}], "]"}], ",", 
      RowBox[{"Exp", "[", 
       RowBox[{"stateLogGrowth", "[", "eps", "]"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"eps", ",", "0", ",", "epsilonMaximum"}], "}"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Change in phenotype\>\"", ",", "\"\<Fitness\>\""}], 
      "}"}]}], ",", 
    RowBox[{"ImageSize", "->", "430"}], ",", 
    RowBox[{"BaseStyle", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FontFamily", "->", "\"\<Helvetica\>\""}], ",", "12"}], 
      "}"}]}]}], "]"}]}], "\[IndentingNewLine]"}], "Input",
