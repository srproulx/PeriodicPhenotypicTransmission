Cell[CellGroupData[{

Cell["Second-derivative surface over transmission parameters", "Section",ExpressionUUID->"f1294275-d284-443c-ac13-d51576b87089"],

Cell["\<\
This section estimates the second derivative of per-generation log growth \
with respect to either phenotype at z1 = z2 = 0. It compares log growth at a \
small positive change, no change, and an equal negative change. Positive \
values indicate that small phenotypic deviations can increase log growth, \
whereas negative values indicate local stabilizing selection. The beta \
endpoints are omitted because the transmission matrix becomes reducible there.\
\>", "Text",ExpressionUUID->"133fdc3e-3b06-405b-b26c-3bca5f29f16a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"secondZDerivativeNumeric", "[", 
    RowBox[{"which_Integer", ",", 
     RowBox[{"beta1Value_", "?", "NumericQ"}], ",", 
     RowBox[{"beta2Value_", "?", "NumericQ"}], ",", 
     RowBox[{"etaValue_", "?", "NumericQ"}], ",", "k_Integer", ",", 
     RowBox[{"epsValue_", ":", 
      FractionBox["1", 
       SuperscriptBox["10", "3"]]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"base", "=", 
        RowBox[{"{", 
         RowBox[{"0.`", ",", "0.`", ",", "beta1Value", ",", "beta2Value"}], 
         "}"}]}], ",", 
       RowBox[{"plus", "=", 
        RowBox[{"{", 
         RowBox[{"0.`", ",", "0.`", ",", "beta1Value", ",", "beta2Value"}], 
         "}"}]}], ",", 
       RowBox[{"minus", "=", 
        RowBox[{"{", 
         RowBox[{"0.`", ",", "0.`", ",", "beta1Value", ",", "beta2Value"}], 
         "}"}]}], ",", "lambdaBase"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], ",", "which"}], "]"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      RowBox[{
       RowBox[{
       "plus", "\[LeftDoubleBracket]", "which", "\[RightDoubleBracket]"}], 
       "=", "epsValue"}], ";", 
      RowBox[{
       RowBox[{
       "minus", "\[LeftDoubleBracket]", "which", "\[RightDoubleBracket]"}], 
       "=", 
       RowBox[{"-", "epsValue"}]}], ";", 
      RowBox[{"lambdaBase", "=", 
       RowBox[{"lambdaNumeric", "[", 
        RowBox[{"base", ",", "etaValue", ",", "k"}], "]"}]}], ";", 
      FractionBox[
       RowBox[{
        RowBox[{"lambdaNumeric", "[", 
         RowBox[{"plus", ",", "etaValue", ",", "k"}], "]"}], "-", 
        RowBox[{"2", " ", "lambdaBase"}], "+", 
        RowBox[{"lambdaNumeric", "[", 
         RowBox[{"minus", ",", "etaValue", ",", "k"}], "]"}]}], 
       SuperscriptBox["epsValue", "2"]]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"makeSecondDerivativeSurface", "[", 
    RowBox[{"which_Integer", ",", "k_Integer", ",", 
     RowBox[{"etaValue_", "?", "NumericQ"}], ",", 
     RowBox[{"epsValue_", ":", 
      FractionBox["1", 
       SuperscriptBox["10", "3"]]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"verticalLabel", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"which", "\[Equal]", "1"}], ",", 
          "\"\<d^2 lambda/d z1^2\>\"", ",", "\"\<d^2 lambda/d z2^2\>\""}], 
         "]"}]}], ",", 
       RowBox[{"title", "=", 
        RowBox[{"\"\<k = \>\"", "<>", 
         RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<, eta^2 = \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"N", "[", 
           SuperscriptBox["etaValue", "2"], "]"}], "]"}]}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], ",", "which"}], "]"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      RowBox[{"Plot3D", "[", 
       RowBox[{
        RowBox[{"secondZDerivativeNumeric", "[", 
         RowBox[{
         "which", ",", "beta1Plot", ",", "beta2Plot", ",", "etaValue", ",", 
          "k", ",", "epsValue"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"beta1Plot", ",", "0.001`", ",", "0.999`"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"beta2Plot", ",", "0.001`", ",", "0.999`"}], "}"}], ",", 
        RowBox[{"PlotPoints", "\[Rule]", "45"}], ",", 
        RowBox[{"MaxRecursion", "\[Rule]", "2"}], ",", 
        RowBox[{"Mesh", "\[Rule]", "None"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], ",", 
        RowBox[{"ColorFunction", "\[Rule]", "\"\<LakeColors\>\""}], ",", 
        RowBox[{"AxesLabel", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["\[Beta]", "1"], ",", 
           SubscriptBox["\[Beta]", "2"], ",", "verticalLabel"}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "title"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "520"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.999194392174356*^9, 3.999194397594726*^9}},
 CellLabel->
  "In[273]:=",ExpressionUUID->"eda44601-09d2-4639-b14b-c349576324f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"secondDerivativeSurfaceK", "=", "6"}], ";", 
  RowBox[{"secondDerivativeSurfaceEta", "=", "1.`"}], ";", 
  RowBox[{"secondDerivativeSurfacePhenotype", "=", "1"}], ";", 
  RowBox[{"secondDerivativeSurface", "=", 
   RowBox[{"makeSecondDerivativeSurface", "[", 
    RowBox[{
    "secondDerivativeSurfacePhenotype", ",", "secondDerivativeSurfaceK", ",", 
     "secondDerivativeSurfaceEta"}], "]"}]}], ";", 
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "outputDirectory", ",", "\"\<second_derivative_surface.pdf\>\""}], 
      "}"}], "]"}], ",", "secondDerivativeSurface"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{3.998501634831256*^9},
 CellLabel->
  "In[274]:=",ExpressionUUID->"b388567d-7137-4cda-9be7-942e6608447c"],

