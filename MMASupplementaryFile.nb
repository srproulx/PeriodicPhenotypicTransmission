Cell[CellGroupData[{

Cell["Established memory system", "Section",ExpressionUUID->"c9466abe-e41b-4332-bf9b-72a0f2183b22"],

Cell["\<\
This section now reports log growth. The comparison uses eta^2 = 1/2, which \
is equivalent to the old coefficient 2 after doubling the phenotype scale.\
\>", "Text",ExpressionUUID->"dbfa637b-35f1-4a6d-bd84-834b94b67934"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"lambdaExtreme", "[", 
     RowBox[{"beta1_", ",", "beta2_", ",", "k_"}], "]"}], ":=", 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}], " ", 
       RowBox[{"Log", "[", "beta1", "]"}]}], "+", 
      RowBox[{"Log", "[", 
       RowBox[{"1", "-", "beta1"}], "]"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}], " ", 
       RowBox[{"Log", "[", "beta2", "]"}]}], "+", 
      RowBox[{"Log", "[", 
       RowBox[{"1", "-", "beta2"}], "]"}]}], 
     RowBox[{"2", " ", "k"}]]}], ";", 
   RowBox[{
    RowBox[{"optimalMemory", "[", "k_", "]"}], ":=", 
    FractionBox[
     RowBox[{"k", "-", "1"}], "k"]}], ";", 
   RowBox[{
    RowBox[{"optimalExtremeLogGrowth", "[", "k_", "]"}], ":=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"lambdaExtreme", "[", 
       RowBox[{
        RowBox[{"optimalMemory", "[", "k", "]"}], ",", 
        RowBox[{"optimalMemory", "[", "k", "]"}], ",", "k"}], "]"}], ",", 
      RowBox[{"Assumptions", "\[Rule]", 
       RowBox[{"k", ">", "1"}]}]}], "]"}]}], ";", 
   RowBox[{"establishedMemoryResults", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<OptimalMemory\>\"", "\[Rule]", 
       FractionBox[
        RowBox[{"k", "-", "1"}], "k"]}], ",", 
      RowBox[{"\"\<OptimalPerGenerationLogGrowth\>\"", "\[Rule]", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"k", "-", "1"}], "k"], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"k", "-", "1"}], "]"}]}], "-", 
        RowBox[{"Log", "[", "k", "]"}]}]}]}], "|>"}]}], ";", 
   RowBox[{"establishedMemoryFigure", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"kValue", "-", "1"}], "kValue"], " ", 
          RowBox[{"Log", "[", 
           RowBox[{"kValue", "-", "1"}], "]"}]}], "-", 
         RowBox[{"Log", "[", "kValue", "]"}]}], ",", 
        RowBox[{"-", 
         FractionBox["1", "2"]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"kValue", ",", "2", ",", "20"}], "}"}], ",", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Environmental run length, k\>\"", ",", 
         "\"\<Per-generation log growth, \[Lambda]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Established memory system\>\"", ",", 
         "\"\<Single-phenotype equilibrium, \[Eta]^2 = 1/2\>\""}], "}"}]}], 
      ",", 
      RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
      RowBox[{"ImageSize", "\[Rule]", "480"}]}], "]"}]}], ";", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "outputDirectory", ",", "\"\<established_memory_growth.pdf\>\""}], 
       "}"}], "]"}], ",", "establishedMemoryFigure"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[686]:=",ExpressionUUID->"22123c48-c1a8-488a-bf5f-e01b3c22b4dd"],

