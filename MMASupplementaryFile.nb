Cell[CellGroupData[{

Cell["Analytical results", "Section",ExpressionUUID->"00e01b3b-93ba-42da-8dd7-5c809b2d6bd5"],

Cell["\<\
The single-phenotype equilibrium is zero on the recoded scale. The \
randomizing-mutant calculation and all derivatives use log growth.\
\>", "Text",ExpressionUUID->"321c3c92-8d35-4b12-b29d-e70f302ec5ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zHat", "=", "0"}], ";", 
   RowBox[{"lambdaHat", "=", 
    RowBox[{"-", 
     SuperscriptBox["eta", "2"]}]}], ";", 
   RowBox[{"lambdaRandomizing", "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"1", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"beta", " ", 
           RowBox[{"fitness", "[", 
            RowBox[{"zHat", ",", "1", ",", "eta"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "beta"}], ")"}], " ", 
           RowBox[{"fitness", "[", 
            RowBox[{
             RowBox[{"zHat", "+", "eps"}], ",", "1", ",", "eta"}], "]"}]}]}], 
         "]"}], "+", 
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"beta", " ", 
           RowBox[{"fitness", "[", 
            RowBox[{"zHat", ",", "2", ",", "eta"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "beta"}], ")"}], " ", 
           RowBox[{"fitness", "[", 
            RowBox[{
             RowBox[{"zHat", "+", "eps"}], ",", "2", ",", "eta"}], "]"}]}]}], 
         "]"}]}], ")"}]}]}]}], ";", 
   RowBox[{"randomizingFirstDerivative", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"lambdaRandomizing", ",", "eps"}], "]"}], "/.", 
       RowBox[{"eps", "\[Rule]", "0"}]}], ",", 
      RowBox[{"Assumptions", "\[Rule]", 
       RowBox[{
        RowBox[{"eta", ">", "0"}], "\[And]", 
        RowBox[{"0", "<", "beta", "<", "1"}]}]}]}], "]"}]}], ";", 
   RowBox[{"randomizingSecondDerivative", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"lambdaRandomizing", ",", 
         RowBox[{"{", 
          RowBox[{"eps", ",", "2"}], "}"}]}], "]"}], "/.", 
       RowBox[{"eps", "\[Rule]", "0"}]}], ",", 
      RowBox[{"Assumptions", "\[Rule]", 
       RowBox[{
        RowBox[{"eta", ">", "0"}], "\[And]", 
        RowBox[{"0", "<", "beta", "<", "1"}]}]}]}], "]"}]}], ";", 
   RowBox[{"randomizingInvasionCondition", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"randomizingSecondDerivative", ">", "0"}], ",", 
      RowBox[{"Assumptions", "\[Rule]", 
       RowBox[{
        RowBox[{"eta", ">", "0"}], "\[And]", 
        RowBox[{"0", "<", "beta", "<", "1"}]}]}]}], "]"}]}], ";", 
   RowBox[{"firstDerivativeChecks", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"k", "\[Rule]", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"lambdaExpression", "[", "k", "]"}], ",", "z1"}], "]"}],
             ",", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"lambdaExpression", "[", "k", "]"}], ",", "z2"}], 
             "]"}]}], "}"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"z1", "\[Rule]", "0"}], ",", 
            RowBox[{"z2", "\[Rule]", "0"}]}], "}"}]}], ",", 
         RowBox[{"Assumptions", "\[Rule]", 
          RowBox[{
           RowBox[{"eta", ">", "0"}], "\[And]", 
           RowBox[{"0", "<", "beta1", "<", "1"}], "\[And]", 
           RowBox[{"0", "<", "beta2", "<", "1"}]}]}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "2", ",", "6"}], "}"}]}], "]"}]}]}], ";"}]], "Input",\

 CellLabel->
  "In[676]:=",ExpressionUUID->"b3385664-361e-43f3-add1-eb2dd26984fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"numericalFirstDerivativeCheck", "[", 
     RowBox[{"k_Integer", ",", 
      RowBox[{"samples_Integer", ":", "10000"}], ",", 
      RowBox[{"seed_Integer", ":", "1234"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"epsValue", "=", 
         FractionBox["2", 
          SuperscriptBox["10", "5"]]}], ",", "etaValue", ",", "b1", ",", "b2",
         ",", "derivative"}], "}"}], ",", 
      RowBox[{
       RowBox[{"SeedRandom", "[", 
        RowBox[{"seed", "+", "k"}], "]"}], ";", 
       RowBox[{"Max", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"etaValue", "=", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{
               FractionBox[
                SqrtBox["2"], "2"], ",", 
               SqrtBox["2"]}], "}"}], "]"}]}], ";", 
           RowBox[{"b1", "=", 
            RowBox[{"RandomReal", "[", "]"}]}], ";", 
           RowBox[{"b2", "=", 
            RowBox[{"RandomReal", "[", "]"}]}], ";", 
           RowBox[{"derivative", "=", 
            FractionBox[
             RowBox[{
              RowBox[{"lambdaNumeric", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"epsValue", ",", "0.`", ",", "b1", ",", "b2"}], 
                 "}"}], ",", "etaValue", ",", "k"}], "]"}], "-", 
              RowBox[{"lambdaNumeric", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "epsValue"}], ",", "0.`", ",", "b1", ",", 
                  "b2"}], "}"}], ",", "etaValue", ",", "k"}], "]"}]}], 
             RowBox[{"2", " ", "epsValue"}]]}], ";", 
           RowBox[{"Abs", "[", "derivative", "]"}]}], ",", 
          RowBox[{"{", "samples", "}"}]}], "]"}], "]"}]}]}], "]"}]}], ";", 
   RowBox[{"longCycleChecks", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"20", "\[Rule]", 
       RowBox[{"numericalFirstDerivativeCheck", "[", "20", "]"}]}], ",", 
      RowBox[{"100", "\[Rule]", 
       RowBox[{"numericalFirstDerivativeCheck", "[", "100", "]"}]}]}], 
     "|>"}]}], ";", 
   RowBox[{"analyticResults", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<SinglePhenotypeESS\>\"", "\[Rule]", "zHat"}], ",", 
      RowBox[{"\"\<SinglePhenotypeLogGrowth\>\"", "\[Rule]", "lambdaHat"}], 
      ",", 
      RowBox[{
      "\"\<RandomizingFirstDerivative\>\"", "\[Rule]", 
       "randomizingFirstDerivative"}], ",", 
      RowBox[{
      "\"\<RandomizingSecondDerivative\>\"", "\[Rule]", 
       "randomizingSecondDerivative"}], ",", 
      RowBox[{
      "\"\<RandomizingInvasionCondition\>\"", "\[Rule]", 
       "randomizingInvasionCondition"}], ",", 
      RowBox[{
      "\"\<GeneralFirstDerivativeChecks\>\"", "\[Rule]", 
       "firstDerivativeChecks"}], ",", 
      RowBox[{
      "\"\<LongCycleNumericalChecks\>\"", "\[Rule]", "longCycleChecks"}]}], 
     "|>"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[677]:=",ExpressionUUID->"97fabebe-eb05-4680-889e-5ff3ccc2cfcb"],

