Cell[CellGroupData[{

Cell["Additional SI figure code", "Section",
 CellChangeTimes->{{4.0009078177154827`*^9, 4.000907817883164*^9}, {
  4.0010877700615377`*^9, 
  4.001087774521525*^9}},ExpressionUUID->"4faefc32-bc8c-4d88-a567-\
ed9df93a6b83"],

Cell[BoxData[
 RowBox[{
  RowBox[{"compact", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     SuperscriptBox["eta", "2"], " ", "q2"}], "+", 
    FractionBox[
     RowBox[{"4", " ", 
      SuperscriptBox["eta", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", " ", "h"}], "-", 
        RowBox[{"4", " ", 
         SuperscriptBox["h", 
          RowBox[{"1", "+", "k"}]]}], "-", "k", "+", 
        RowBox[{
         SuperscriptBox["h", "2"], " ", "k"}], "-", 
        RowBox[{
