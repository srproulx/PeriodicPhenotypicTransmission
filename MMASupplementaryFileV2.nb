Cell[CellGroupData[{

Cell["Compare to DME", "Subsection",
 CellChangeTimes->{{3.99857745876331*^9, 
  3.9985774611060257`*^9}},ExpressionUUID->"b76bccee-7832-4653-ad69-\
2f3abe863d50"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kValue", "=", "6"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"etaValue", "=", "1"}], ";"}], "          "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"beta1Value", "=", 
    RowBox[{"5", "/", "6"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"beta2Value", "=", 
   RowBox[{"5", "/", "6"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"epsilonMaximum", "=", "0.5"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lambdaAncestor", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"w", "[", 
         RowBox[{"0", ",", "1", ",", "etaValue"}], "]"}], "]"}], "+", 
       RowBox[{"Log", "[", 
        RowBox[{"w", "[", 
         RowBox[{"0", ",", "2", ",", "etaValue"}], "]"}], "]"}]}], ")"}], "/",
      "2"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Deterministic", " ", "maternal", " ", "effect"}], ",", 
    RowBox[{"with", " ", "phenotypes", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "eps"}], "/", "2"}], ",", 
       RowBox[{
        RowBox[{"+", "eps"}], "/", "2"}]}], "}"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dmeLogGrowth", "[", 
     RowBox[{"eps_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"kValue", "-", "1"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "kValue"}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"w", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "eps"}], "/", "2"}], ",", "1", ",", "etaValue"}], 
          "]"}], "]"}], "+", 
        RowBox[{"Log", "[", 
         RowBox[{"w", "[", 
          RowBox[{
           RowBox[{"eps", "/", "2"}], ",", "2", ",", "etaValue"}], "]"}], 
         "]"}]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "kValue"}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"w", "[", 
          RowBox[{
           RowBox[{"eps", "/", "2"}], ",", "1", ",", "etaValue"}], "]"}], 
         "]"}], "+", 
        RowBox[{"Log", "[", 
         RowBox[{"w", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "eps"}], "/", "2"}], ",", "2", ",", "etaValue"}], 
          "]"}], "]"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"State", "-", 
     RowBox[{"transmission", " ", "mutant"}]}], ",", 
    RowBox[{"with", " ", "phenotypes", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "eps"}], "/", "2"}], ",", 
       RowBox[{
        RowBox[{"+", "eps"}], "/", "2"}]}], "}"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stateLogGrowth", "[", 
     RowBox[{"eps_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"lambdaNumeric", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "eps"}], "/", "2"}], ",", 
        RowBox[{"eps", "/", "2"}], ",", "beta1Value", ",", "beta2Value"}], 
       "}"}], ",", "etaValue", ",", "kValue"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"dmeColor", "=", 
   RowBox[{"RGBColor", "[", 
    RowBox[{"0.80", ",", "0.20", ",", "0.15"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stateColor", "=", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0.00", ",", "0.45", ",", "0.70"}], "]"}]}], ";"}], "\n", "\n", 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"dmeComparisonFigure", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"dmeLogGrowth", "[", "eps", "]"}], "]"}], ",", 
      RowBox[{"Exp", "[", 
       RowBox[{"stateLogGrowth", "[", "eps", "]"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"eps", ",", "0", ",", "epsilonMaximum"}], "}"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Change in phenotype\>\"", ",", "\"\<Fitness\>\""}], 
      "}"}]}], ",", 
    RowBox[{"ImageSize", "->", "430"}], ",", 
    RowBox[{"BaseStyle", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FontFamily", "->", "\"\<Helvetica\>\""}], ",", "12"}], 
      "}"}]}]}], "]"}]}], "\[IndentingNewLine]"}], "Input",
