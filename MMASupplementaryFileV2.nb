            RowBox[{"z2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"eta", ",", "_Real"}], "}"}]}], "}"}], ",", 
         RowBox[{"Evaluate", "[", "expr", "]"}]}], "]"}]}], "]"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gradientCompiled", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"gradientCompiled", "[", "k", "]"}], "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr", "=", 
         RowBox[{"gradientExpression", "[", "k", "]"}]}], "}"}], ",", 
       RowBox[{"Compile", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"z1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"z2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta2", ",", "_Real"}], "}"}], ",", 
