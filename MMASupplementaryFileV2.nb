         RowBox[{"Evaluate", "[", "expr", "]"}]}], "]"}]}], "]"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"secondZ2Compiled", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"secondZ2Compiled", "[", "k", "]"}], "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr", "=", 
         RowBox[{"secondZ2Expression", "[", "k", "]"}]}], "}"}], ",", 
       RowBox[{"Compile", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"beta1", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"beta2", ",", "_Real"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"eta", ",", "_Real"}], "}"}]}], "}"}], ",", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"Re", "[", "expr", "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lambdaNumeric", "[", 
    RowBox[{"params_List", ",", 
     RowBox[{"etaValue_", "?", "NumericQ"}], ",", "k_Integer"}], "]"}], ":=", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "=", 
        RowBox[{"N", "[", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}], "]"}]}], ",", 
       "dominantRoot", ",", "b", ",", "a1", ",", "a2", ",", "scale", ",", 
       RowBox[{"logScale", "=", "0."}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"b", "=", 
       RowBox[{"transmissionMatrix", "[", 
        RowBox[{
         RowBox[{"params", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"params", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"a1", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"selectionMatrix", "[", 
          RowBox[{"1", ",", 
           RowBox[{"params", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"params", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "etaValue"}], "]"}], ".", 
         "b"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"a2", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"selectionMatrix", "[", 
          RowBox[{"2", ",", 
           RowBox[{"params", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"params", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "etaValue"}], "]"}], ".", 
         "b"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"m", "=", 
          RowBox[{"m", ".", "a"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"scale", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Flatten", "[", "m", "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"TrueQ", "[", 
             RowBox[{"scale", ">", "0."}], "]"}]}], ",", 
           RowBox[{"Return", "[", "Indeterminate", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"m", "=", 
          RowBox[{"m", "/", "scale"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"logScale", "+=", 
          RowBox[{"Log", "[", "scale", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"a1", ",", "k"}], "]"}], ",", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"a2", ",", "k"}], "]"}]}], "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dominantRoot", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"Eigenvalues", "[", "m", "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"dominantRoot", ">", "0."}], "]"}]}], ",", 
        RowBox[{"Return", "[", "Indeterminate", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"logScale", "+", 
         RowBox[{"Log", "[", "dominantRoot", "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "k"}], ")"}]}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.000557689894229*^9, 4.00055768989671*^9}, 
   4.001070397132803*^9},
 CellLabel->"In[91]:=",ExpressionUUID->"b4656d16-fa6d-4b12-acba-5b278fa38b31"]
