Cell[CellGroupData[{

Cell["Origin versus maintenance: hysteresis", "Section",ExpressionUUID->"98f3960d-36e5-4c99-aa7e-6e5bc6ae8fe0"],

Cell["\<\
The scan is expressed directly in eta^2. Each call to the evolutionary \
routine receives eta = Sqrt[etaSquared]. The phenotype starting values, \
collapse criterion, and vertical plotting scale have all been doubled \
relative to the old 0-to-1 phenotype coordinate.\
\>", "Text",ExpressionUUID->"01ca4096-a427-4abb-a6ff-2b3ea4797fad"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"evolveToEquilibrium", "[", 
    RowBox[{"k_Integer", ",", 
     RowBox[{"etaValue_", "?", "NumericQ"}], ",", "startingParameters_List", 
     ",", 
     RowBox[{"tolerance_", ":", 
      FractionBox["1", 
       SuperscriptBox["10", "4"]]}], ",", 
     RowBox[{"stepSize_", ":", "1.`"}], ",", 
     RowBox[{"maximumSteps_Integer", ":", "30000"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"parameters", "=", 
        RowBox[{"N", "[", "startingParameters", "]"}]}], ",", 
       RowBox[{"gradientFunction", "=", 
        RowBox[{"gradientCompiled", "[", "k", "]"}]}], ",", "gradient", ",", 
       "effectiveGradient", ",", "parameterToChange", ",", 
       RowBox[{"step", "=", "0"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"step", "<", "maximumSteps"}], ",", 
        RowBox[{
         RowBox[{"gradient", "=", 
          RowBox[{"N", "[", 
           RowBox[{"gradientFunction", "[", 
            RowBox[{
             RowBox[{
             "parameters", "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}], ",", 
             RowBox[{
             "parameters", "\[LeftDoubleBracket]", "2", 
              "\[RightDoubleBracket]"}], ",", 
             RowBox[{
             "parameters", "\[LeftDoubleBracket]", "3", 
              "\[RightDoubleBracket]"}], ",", 
             RowBox[{
             "parameters", "\[LeftDoubleBracket]", "4", 
              "\[RightDoubleBracket]"}], ",", "etaValue"}], "]"}], "]"}]}], 
         ";", 
         RowBox[{"effectiveGradient", "=", 
          RowBox[{"gradient", " ", 
           RowBox[{"{", 
            RowBox[{"2.`", ",", "2.`", ",", "1.`", ",", "1.`"}], "}"}]}]}], 
         ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "effectiveGradient", "]"}], "]"}], 
            "\[LessEqual]", "tolerance"}], ",", 
           RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
         RowBox[{"parameterToChange", "=", 
          RowBox[{"First", "[", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "effectiveGradient", "]"}], ",", 
             RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", 
         RowBox[{
          RowBox[{
          "parameters", "\[LeftDoubleBracket]", "parameterToChange", 
           "\[RightDoubleBracket]"}], "=", 
          RowBox[{"invLogit", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"logit", "[", 
              RowBox[{
               RowBox[{
               "parameters", "\[LeftDoubleBracket]", "parameterToChange", 
                "\[RightDoubleBracket]"}], ",", "parameterToChange"}], "]"}], 
             "+", 
             RowBox[{"stepSize", " ", 
              RowBox[{
              "effectiveGradient", "\[LeftDoubleBracket]", 
               "parameterToChange", "\[RightDoubleBracket]"}]}]}], ",", 
            "parameterToChange"}], "]"}]}], ";", 
         RowBox[{"step", "++"}], ";", "Null"}]}], "]"}], ";", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<FinalParameters\>\"", "\[Rule]", "parameters"}], ",", 
        RowBox[{"\"\<Steps\>\"", "\[Rule]", "step"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[694]:=",ExpressionUUID->"be777fd4-fe1c-41c9-b1fb-79e634a2a002"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"hysteresisK", "=", "6"}], ";", 
   RowBox[{"etaSquaredValues", "=", 
    RowBox[{"N", "[", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{
         FractionBox["1", "8"], ",", 
         FractionBox["79", "80"], ",", 
         FractionBox["3", "80"]}], "]"}], ",", "1"}], "]"}], "]"}]}], ";", 
   RowBox[{"noMemoryStartingParameters", "=", 
    RowBox[{"{", 
     RowBox[{"0.`", ",", "0.1`", ",", "0.99`", ",", "0.01`"}], "}"}]}], ";", 
   RowBox[{"originData", "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"parameters", "=", "noMemoryStartingParameters"}], ",", 
        "result"}], "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
              "parameters", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}], "]"}], "<", "0.1`"}], "\[Or]", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
              "parameters", "\[LeftDoubleBracket]", "2", 
               "\[RightDoubleBracket]"}], "]"}], "<", "0.1`"}]}], ",", 
           RowBox[{"parameters", "=", "noMemoryStartingParameters"}]}], "]"}],
          ";", 
         RowBox[{"result", "=", 
          RowBox[{"evolveToEquilibrium", "[", 
           RowBox[{"hysteresisK", ",", 
            SqrtBox["etaSquared"], ",", "parameters", ",", 
            FractionBox["1", 
             SuperscriptBox["10", "4"]], ",", "1.`", ",", "30000"}], "]"}]}], 
         ";", 
         RowBox[{"parameters", "=", 
          RowBox[{"result", "[", "\"\<FinalParameters\>\"", "]"}]}], ";", 
         RowBox[{"{", 
          RowBox[{"etaSquared", ",", 
           RowBox[{
           "parameters", "\[LeftDoubleBracket]", "1", 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "parameters", "\[LeftDoubleBracket]", "2", 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "parameters", "\[LeftDoubleBracket]", "3", 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "parameters", "\[LeftDoubleBracket]", "4", 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{"result", "[", "\"\<Steps\>\"", "]"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"etaSquared", ",", "etaSquaredValues"}], "}"}]}], "]"}]}], 
     "]"}]}], ";", 
   RowBox[{"maintenanceData", "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"parameters", "=", "noMemoryStartingParameters"}], ",", 
        "result"}], "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"result", "=", 
          RowBox[{"evolveToEquilibrium", "[", 
           RowBox[{"hysteresisK", ",", 
            SqrtBox["etaSquared"], ",", "parameters", ",", 
            FractionBox["1", 
             SuperscriptBox["10", "4"]], ",", "1.`", ",", "30000"}], "]"}]}], 
         ";", 
         RowBox[{"parameters", "=", 
          RowBox[{"result", "[", "\"\<FinalParameters\>\"", "]"}]}], ";", 
         RowBox[{"{", 
          RowBox[{"etaSquared", ",", 
           RowBox[{
           "parameters", "\[LeftDoubleBracket]", "1", 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "parameters", "\[LeftDoubleBracket]", "2", 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "parameters", "\[LeftDoubleBracket]", "3", 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{
