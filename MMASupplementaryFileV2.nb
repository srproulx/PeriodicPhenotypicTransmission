Notebook[{

Cell[CellGroupData[{
Cell["\<\
Associated Mathematica file for Proulx and Teotonio \
\[OpenCurlyDoubleQuote]Weak selection of phenotypic memory in periodic \
environments\[CloseCurlyDoubleQuote]\
\>", "Title",
 CellChangeTimes->{{4.000342057733918*^9, 
  4.00034207859585*^9}},ExpressionUUID->"a3e810bf-ce88-43a6-8152-\
922ff5d7e1d2"],

Cell["\<\
This notebook creates figures and results in the paper.  Phenotypes and \
environmental optima are on the interval -1 to 1, fitness is Exp[-eta^2 \
(z-z*)^2], and lambda is per-generation asymptotic log growth. Evaluate the \
notebook from top to bottom. \
\>", "Text",
 CellChangeTimes->{{4.000342031838687*^9, 4.00034205367587*^9}, 
   4.000560956404625*^9},ExpressionUUID->"a6d692a7-b21b-4996-b6f4-\
0544f97a3f59"],

