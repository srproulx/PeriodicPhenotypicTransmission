         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.9`", ",", "0.6`", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.35`", ",", "0.7`", ",", "0.9`"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.6`", ",", "0.5`"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.95`", ",", "0.9`", ",", "0.25`"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.45`", ",", "0.7`"}], "}"}], ",", 
