Cell[CellGroupData[{

Cell["Invasion regions for small phenotypic differences", "Section",ExpressionUUID->"f6431c5f-4801-4734-bcba-8f5b93bd1502"],

Cell["\<\
The randomization plot uses eta^2 as the mismatch-strength axis. To preserve \
the existing calls to makeMemoryRegionPanel, that function accepts the old \
0-to-1-scale coefficient values and internally uses eta = \
Sqrt[oldStrength]/2; displayed labels report eta^2 = oldStrength/4.\
\>", "Text",ExpressionUUID->"5b47549e-7179-404c-a5e6-bd3dee2223e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"randomizationRegionFigure", "=", 
   RowBox[{"RegionPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"etaSquaredPlot", " ", "betaPlot"}], ">", 
      FractionBox["1", "2"]}], ",", 
     RowBox[{"{", 
      RowBox[{"etaSquaredPlot", ",", 
       FractionBox["1", "2"], ",", 
       FractionBox["5", "2"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"betaPlot", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<Mismatch strength, \[Eta]^2\>\"", ",", "\[Beta]"}], 
       "}"}]}], ",", 
     RowBox[{"PlotPoints", "\[Rule]", "60"}], ",", 
     RowBox[{"MaxRecursion", "\[Rule]", "2"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "420"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[682]:=",ExpressionUUID->"a21f04e9-5c48-4e8d-850d-8e770af6a337"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"makeMemoryRegionPanel", "[", 
    RowBox[{
    "k_Integer", ",", "oldStrengthValues_List", ",", "panelLabel_String", ",",
      "etaLabelPositions_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"colors", ",", "positiveQ", ",", "plots", ",", "etaLabels"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"colors", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{
           "okabeIto", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
            ",", 
           RowBox[{"Opacity", "[", "1", "]"}]}], "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{
           "okabeIto", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
            ",", 
           RowBox[{"Opacity", "[", "0.6`", "]"}]}], "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{
           "okabeIto", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}],
            ",", 
           RowBox[{"Opacity", "[", "0.6`", "]"}]}], "]"}]}], "}"}]}], ";", 
      RowBox[{
       RowBox[{"positiveQ", "[", 
        RowBox[{
         RowBox[{"beta2_", "?", "NumericQ"}], ",", 
         RowBox[{"beta1_", "?", "NumericQ"}], ",", 
         RowBox[{"oldStrength_", "?", "NumericQ"}]}], "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"secondZ2Compiled", "[", "k", "]"}], "[", 
         RowBox[{"beta1", ",", "beta2", ",", 
          FractionBox[
           SqrtBox[
            RowBox[{"N", "[", "oldStrength", "]"}]], "2"]}], "]"}], ">", 
        "0"}]}], ";", 
      RowBox[{"plots", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"oldStrength", ",", "color"}], "}"}], ",", 
           RowBox[{"RegionPlot", "[", 
            RowBox[{
             RowBox[{"positiveQ", "[", 
              RowBox[{"beta2Plot", ",", "beta1Plot", ",", "oldStrength"}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"beta2Plot", ",", "0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"beta1Plot", ",", "0", ",", "1"}], "}"}], ",", 
             RowBox[{"PlotStyle", "\[Rule]", "color"}], ",", 
             RowBox[{"BoundaryStyle", "\[Rule]", "None"}], ",", 
             RowBox[{"PlotPoints", "\[Rule]", "50"}], ",", 
             RowBox[{"MaxRecursion", "\[Rule]", "2"}]}], "]"}]}], "]"}], ",", 
         
         RowBox[{"{", 
          RowBox[{"oldStrengthValues", ",", "colors"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"etaLabels", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Inset", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"\"\<\[Eta]^2 = \>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"N", "[", 
                 FractionBox[
                  RowBox[{
                  "#1", "\[LeftDoubleBracket]", "1", 
                   "\[RightDoubleBracket]"}], "4"], "]"}], "]"}]}], ",", "11",
               ",", "Black"}], "]"}], ",", 
            RowBox[{
            "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
           "]"}], "&"}], ")"}], "/@", "etaLabelPositions"}]}], ";", 
      RowBox[{"Show", "[", 
       RowBox[{"plots", ",", 
        RowBox[{"Frame", "\[Rule]", "True"}], ",", 
        RowBox[{"FrameLabel", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["\[Beta]", "2"], ",", 
           SubscriptBox["\[Beta]", "1"]}], "}"}]}], ",", 
        RowBox[{"PlotRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"PlotRangePadding", "\[Rule]", 
         RowBox[{"Scaled", "[", "0.02`", "]"}]}], ",", 
        RowBox[{"Epilog", "\[Rule]", 
         RowBox[{"Join", "[", 
          RowBox[{"etaLabels", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Inset", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"panelLabel", ",", "14", ",", "Bold"}], "]"}], ",", 
               RowBox[{"Scaled", "[", 
                RowBox[{"{", 
                 RowBox[{"0.95`", ",", "0.95`"}], "}"}], "]"}]}], "]"}], ",", 
             
             RowBox[{"Inset", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"\"\<k = \>\"", "<>", 
                  RowBox[{"ToString", "[", "k", "]"}]}], ",", "12"}], "]"}], 
               ",", 
               RowBox[{"Scaled", "[", 
                RowBox[{"{", 
                 RowBox[{"0.86`", ",", "0.08`"}], "}"}], "]"}]}], "]"}]}], 
            "}"}]}], "]"}]}], ",", 
        RowBox[{"ImagePadding", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"45", ",", "12"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"40", ",", "12"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "360"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[683]:=",ExpressionUUID->"207ebeac-9d69-4810-96e2-7ce95a6a390a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"memoryRegionFigure", "=", 
    RowBox[{"GraphicsRow", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"makeMemoryRegionPanel", "[", 
         RowBox[{"2", ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "3", ",", "2.5`"}], "}"}], ",", "\"\<A\>\"", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
