Cell[CellGroupData[{

Cell["Analytic results for the derivative of the eigenvalues", "Subsection",
 CellChangeTimes->{{3.99857745876331*^9, 3.9985774611060257`*^9}, {
  4.000341031018096*^9, 
  4.000341040957443*^9}},ExpressionUUID->"96abaed7-20f1-4f46-ba4c-\
923d1761ae9a"],

Cell[CellGroupData[{

Cell["Model and parameters", "Subsubsection",ExpressionUUID->"45f89465-b08c-4305-810f-92ef29e18d83"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"beta1", ",", 
       RowBox[{"1", "-", "beta1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "-", "beta2"}], ",", "beta2"}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"betaAssumptions", "=", 
   RowBox[{
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"beta1", ",", "beta2"}], "}"}], ",", "Reals"}], "]"}], "&&", 
    RowBox[{"0", "<", "beta1", "<", "1"}], "&&", 
    RowBox[{"0", "<", "beta2", "<", "1"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"parameterRules", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"q1", ",", "q2"}], "}"}], ".", "b"}], "==", 
          RowBox[{"{", 
           RowBox[{"q1", ",", "q2"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"q1", "+", "q2"}], "==", "1"}], ",", 
          RowBox[{"h", "==", 
           RowBox[{"beta1", "+", "beta2", "-", "1"}]}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"beta1", ",", "beta2", ",", "q1"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"b", "/.", "parameterRules"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"assumptions", "=", 
   RowBox[{
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eta", ",", "h", ",", "q2", ",", "x"}], "}"}], ",", "Reals"}], 
     "]"}], "&&", 
    RowBox[{"eta", ">", "0"}], "&&", 
    RowBox[{
     RowBox[{"-", "1"}], "<", "h", "<", "1"}], "&&", 
    RowBox[{"0", "<", "q2", "<", "1"}], "&&", 
    RowBox[{"Element", "[", 
     RowBox[{"k", ",", "Integers"}], "]"}], "&&", 
    RowBox[{"k", ">=", "1"}], "&&", 
    RowBox[{"(", 
     RowBox[{"And", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"0", "<", "#", "<", "1"}], "&"}], "/@", 
        RowBox[{"Flatten", "[", "b", "]"}]}], ")"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"w", "[", 
    RowBox[{"e_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        RowBox[{"eta", "^", "2"}]}], "]"}], ",", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"eta", "^", "2"}]}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"e", "-", "z"}], ")"}], "^", "2"}]}], "]"}]}], "}"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.000228738442171*^9, 4.000228741671187*^9}, {
   4.000254387575398*^9, 4.000254407070608*^9}, 4.000340669212842*^9, {
   4.0003412132519693`*^9, 4.000341216290503*^9}},
 CellLabel->"In[87]:=",ExpressionUUID->"47a217c1-9f7d-4ac0-8dd3-7222ff1c8dc9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Cycle and ancestral growth", "Subsubsection",ExpressionUUID->"022a13be-4749-43a2-beb1-9518e5ea7cca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cycle", "=", 
   RowBox[{
    RowBox[{"MatrixPower", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "x"}], "]"}], ".", "b"}], ",", "k"}], "]"}],
     ".", 
    RowBox[{"MatrixPower", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "[", 
        RowBox[{"1", ",", "x"}], "]"}], ".", "b"}], ",", "k"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"polynomial", "=", 
   RowBox[{"CharacteristicPolynomial", "[", 
    RowBox[{"cycle", ",", "y"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"characteristic", "=", 
   RowBox[{"polynomial", "/.", 
    RowBox[{"y", "->", 
     RowBox[{"Exp", "[", 
      RowBox[{"2", "*", "k", "*", 
       RowBox[{"lambda", "[", "x", "]"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{"lambda0", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Log", "[", 
     RowBox[{"Max", "@@", 
      RowBox[{"Eigenvalues", "[", 
       RowBox[{
        RowBox[{"w", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "]"}], ".", "b"}], "]"}]}], "]"}], 
    ",", "assumptions"}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.000254480507205*^9, 4.000254490563725*^9}, {
  4.000340659789294*^9, 4.0003406783764515`*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"2c3aaeb3-89dc-4539-8c30-b585ea3987bf"],

Cell[BoxData[
 RowBox[{"-", 
  SuperscriptBox["eta", "2"]}]], "Output",
 CellChangeTimes->{4.000560886615027*^9},
 CellLabel->"Out[96]=",ExpressionUUID->"7f1ca569-af35-42bd-9354-d97f1d6e67a4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Log-growth derivatives", "Subsubsection",ExpressionUUID->"060f495c-d168-48fc-afdd-e3d77d45ee34"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rule0", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"lambda", "[", "0", "]"}], "->", "lambda0"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"firstDerivative", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"characteristic", ",", "x"}], "]"}], "/.", 
        RowBox[{"x", "->", "0"}]}], ")"}], "/.", "rule0"}], ",", 
     "assumptions"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rule1", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"firstDerivative", "==", "0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", "1", "]"}], "[", "lambda", "]"}], "[", "0",
        "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"secondDerivative", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"characteristic", ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "/.", 
        RowBox[{"x", "->", "0"}]}], ")"}], "/.", 
      RowBox[{"Join", "[", 
       RowBox[{"rule0", ",", "rule1"}], "]"}]}], ",", "assumptions"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rule2", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"secondDerivative", "==", "0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", "2", "]"}], "[", "lambda", "]"}], "[", "0",
        "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"lambda2", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", "2", "]"}], "[", "lambda", "]"}], "[", "0", 
      "]"}], "/.", "rule2"}], ",", "assumptions"}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.000254595980174*^9, 4.000254600258182*^9}, {
  4.000340674357473*^9, 4.000340686602172*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"ed3fc112-576e-44a6-ad13-68137c6683a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "2"}], " ", 
   SuperscriptBox["eta", "2"], " ", "q2"}], "+", 
  FractionBox[
   RowBox[{"4", " ", 
    SuperscriptBox["eta", "4"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "k"}], "+", 
      RowBox[{"h", " ", 
       RowBox[{"(", 
        RowBox[{"4", "+", 
         RowBox[{"h", " ", "k"}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["h", "k"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], " ", "h"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["h", "2"]}], ")"}], " ", "k"}]}], ")"}]}]}], ")"}],
     " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "q2"}], ")"}], " ", "q2"}], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "h"}], ")"}], "2"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox["h", "k"]}], ")"}], " ", "k"}]]}]], "Output",
 CellChangeTimes->{4.000560887293295*^9},
 CellLabel->
  "Out[102]=",ExpressionUUID->"b6391775-a0bb-4c76-a9d6-34eed218032f"]
}, Open  ]]
