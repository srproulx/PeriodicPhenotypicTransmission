         RowBox[{"gradientCompiled", "[", "hysteresisK", "]"}]}], ",", 
        "gradient", ",", "effectiveGradient", ",", "parameterToChange", ",", 
        "step", ",", "x", ",", "etaValue"}], "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
