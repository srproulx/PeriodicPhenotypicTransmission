Cell[CellGroupData[{

Cell["Simulation", "Subsection",
 CellChangeTimes->{{4.0005591323422747`*^9, 
  4.0005591393778143`*^9}},ExpressionUUID->"7ee58ade-cbff-42bc-bca0-\
5e71afcff045"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mainK", "=", "6"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mainEta", "=", 
   RowBox[{"Sqrt", "[", "0.75", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mainInitialParameters", "=", 
   RowBox[{"{", 
    RowBox[{"0.", ",", "0.1", ",", "0.99", ",", "0.01"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mainTolerance", "=", 
   RowBox[{"1", "/", 
    RowBox[{"10", "^", "4"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mainStepSize", "=", "1."}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mainMaxSteps", "=", "10000"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mainTrajectory", "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"params", "=", 
         RowBox[{"N", "[", "mainInitialParameters", "]"}]}], ",", 
        RowBox[{"gradFun", "=", 
         RowBox[{"gradientCompiled", "[", "mainK", "]"}]}], ",", 
        RowBox[{"lamFun", "=", 
         RowBox[{"lambdaCompiled", "[", "mainK", "]"}]}], ",", "grad", ",", 
        "effectiveGradient", ",", "index", ",", 
        RowBox[{"records", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"step", "=", "0"}], ",", "lam", ",", "info", ",", 
        "maxGradient", ",", "x", ",", "env", ",", "pairedEnv", ",", 
        "infoMaximum", ",", "m", ",", "eigensystem", ",", "dominantIndex", 
        ",", "state", ",", "states", ",", "b", ",", "joint", ",", "pEnv", ",",
         "pPhen", ",", "mutualInfo"}], "}"}], ",", 
      RowBox[{
       RowBox[{"env", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", "mainK"}], "]"}], ",", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"2", ",", "mainK"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pairedEnv", "=", 
        RowBox[{"RotateLeft", "[", "env", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"infoMaximum", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"mainK", ">", "2"}], ",", 
          RowBox[{"N", "[", 
           RowBox[{"1", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "mainK"}], ")"}], " ", 
             RowBox[{"Log", "[", 
              RowBox[{"2", ",", 
               RowBox[{"1", "/", "mainK"}]}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"1", "/", "mainK"}]}], ")"}], " ", 
             RowBox[{"Log", "[", 
              RowBox[{"2", ",", 
               RowBox[{"1", "-", 
                RowBox[{"1", "/", "mainK"}]}]}], "]"}]}]}], "]"}], ",", 
          "Indeterminate"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"step", "<=", "mainMaxSteps"}], ",", 
         RowBox[{
          RowBox[{"grad", "=", 
           RowBox[{"N", "[", 
            RowBox[{"gradFun", "@@", 
             RowBox[{"Join", "[", 
              RowBox[{"params", ",", 
               RowBox[{"{", "mainEta", "}"}]}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"effectiveGradient", "=", 
           RowBox[{"grad", " ", 
            RowBox[{"{", 
             RowBox[{"2.", ",", "2.", ",", "1.", ",", "1."}], "}"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"lam", "=", 
           RowBox[{"N", "[", 
            RowBox[{"lamFun", "@@", 
             RowBox[{"Join", "[", 
              RowBox[{"params", ",", 
               RowBox[{"{", "mainEta", "}"}]}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Relative", " ", "information"}], ",", 
            RowBox[{"calculated", " ", "directly"}]}], "*)"}], 
          RowBox[{"info", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"mainK", ">", "2"}], ",", 
             RowBox[{
              RowBox[{"m", "=", 
               RowBox[{"N", "[", 
                RowBox[{"cycleMatrix", "[", 
                 RowBox[{
                  RowBox[{"params", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", 
                  RowBox[{"params", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", 
                  RowBox[{"params", "[", 
                   RowBox[{"[", "3", "]"}], "]"}], ",", 
                  RowBox[{"params", "[", 
                   RowBox[{"[", "4", "]"}], "]"}], ",", "mainEta", ",", 
                  "mainK"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"eigensystem", "=", 
               RowBox[{"Eigensystem", "[", 
                RowBox[{"Transpose", "[", "m", "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"dominantIndex", "=", 
               RowBox[{"First", "[", 
                RowBox[{"Ordering", "[", 
                 RowBox[{
                  RowBox[{"Re", "[", 
                   RowBox[{"eigensystem", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                  RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"state", "=", 
               RowBox[{"Abs", "[", 
                RowBox[{"Re", "[", 
                 RowBox[{"eigensystem", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", "dominantIndex"}], "]"}], "]"}], "]"}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"state", "=", 
               RowBox[{"state", "/", 
                RowBox[{"Total", "[", "state", "]"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"b", "=", 
               RowBox[{"transmissionMatrix", "[", 
                RowBox[{
                 RowBox[{"params", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], ",", 
                 RowBox[{"params", "[", 
                  RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Offspring", " ", "frequencies", " ", "paired", " ", "with", 
                " ", "the", " ", "next", " ", "environment"}], "*)"}], 
              RowBox[{"states", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"state", "=", 
                   RowBox[{"state", ".", 
                    RowBox[{"selectionMatrix", "[", 
                    RowBox[{"e", ",", 
                    RowBox[{"params", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"params", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "mainEta"}], "]"}], 
                    ".", "b"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"state", "=", 
                   RowBox[{"state", "/", 
                    RowBox[{"Total", "[", "state", "]"}]}]}], ";", 
                  "\[IndentingNewLine]", "state"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"e", ",", "env"}], "}"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"joint", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Total", "[", 
                   RowBox[{"Pick", "[", 
                    RowBox[{
                    RowBox[{"states", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "i"}], "]"}], "]"}], ",", "pairedEnv",
                     ",", "e"}], "]"}], "]"}], "/", 
                  RowBox[{"(", 
                   RowBox[{"2", " ", "mainK"}], ")"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"e", ",", "1", ",", "2"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"pEnv", "=", 
               RowBox[{"Total", "/@", "joint"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"pPhen", "=", 
               RowBox[{"Total", "[", "joint", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"mutualInfo", "=", 
               RowBox[{"Total", "[", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"joint", "[", 
                    RowBox[{"[", 
                    RowBox[{"e", ",", "i"}], "]"}], "]"}], ">", "0"}], ",", 
                    RowBox[{
                    RowBox[{"joint", "[", 
                    RowBox[{"[", 
                    RowBox[{"e", ",", "i"}], "]"}], "]"}], " ", 
                    RowBox[{"Log", "[", 
                    RowBox[{"2", ",", 
                    RowBox[{
                    RowBox[{"joint", "[", 
                    RowBox[{"[", 
                    RowBox[{"e", ",", "i"}], "]"}], "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"pEnv", "[", 
                    RowBox[{"[", "e", "]"}], "]"}], " ", 
                    RowBox[{"pPhen", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}]}], "]"}]}], ",",
                     "0."}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"e", ",", "1", ",", "2"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"N", "[", 
               RowBox[{"mutualInfo", "/", "infoMaximum"}], "]"}]}], ",", 
             "Indeterminate"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"maxGradient", "=", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "effectiveGradient", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"records", ",", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", "step", "}"}], ",", "params", ",", 
              RowBox[{"{", 
               RowBox[{"lam", ",", 
                RowBox[{"Norm", "[", "effectiveGradient", "]"}], ",", 
                "info"}], "}"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"maxGradient", "<=", "mainTolerance"}], "||", 
             RowBox[{"step", "==", "mainMaxSteps"}]}], ",", 
            RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"index", "=", 
           RowBox[{"First", "[", 
            RowBox[{"Ordering", "[", 
             RowBox[{
              RowBox[{"Abs", "[", "effectiveGradient", "]"}], ",", 
              RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Shifted", " ", "phenotype", " ", "logit"}], ";", 
            RowBox[{"ordinary", " ", "retention", " ", "logit"}]}], "*)"}], 
          RowBox[{"x", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"index", "<=", "2"}], ",", 
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"params", "[", 
                  RowBox[{"[", "index", "]"}], "]"}]}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"params", "[", 
                  RowBox[{"[", "index", "]"}], "]"}]}], ")"}]}], "]"}], ",", 
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{"params", "[", 
                RowBox[{"[", "index", "]"}], "]"}], "/", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"params", "[", 
                  RowBox[{"[", "index", "]"}], "]"}]}], ")"}]}], "]"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"x", "=", 
           RowBox[{"x", "+", 
            RowBox[{"mainStepSize", " ", 
             RowBox[{"effectiveGradient", "[", 
              RowBox[{"[", "index", "]"}], "]"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"params", "[", 
            RowBox[{"[", "index", "]"}], "]"}], "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"index", "<=", "2"}], ",", 
             RowBox[{
              RowBox[{"2", "/", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"-", "x"}], "]"}]}], ")"}]}], "-", "1"}], ",", 
             RowBox[{"1", "/", 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"Exp", "[", 
                 RowBox[{"-", "x"}], "]"}]}], ")"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"step", "++"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Columns\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Step\>\"", ",", "\"\<z1\>\"", ",", "\"\<z2\>\"", ",", 
            "\"\<beta1\>\"", ",", "\"\<beta2\>\"", ",", "\"\<lambda\>\"", 
            ",", "\"\<EvolutionaryGradientNorm\>\"", ",", 
            "\"\<RelativeInformation\>\""}], "}"}]}], ",", 
         RowBox[{"\"\<Data\>\"", "->", "records"}], ",", 
         RowBox[{"\"\<FinalParameters\>\"", "->", "params"}], ",", 
         RowBox[{"\"\<Steps\>\"", "->", "step"}]}], "|>"}]}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trajectoryData", "=", 
   RowBox[{"mainTrajectory", "[", "\"\<Data\>\"", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0005591404394484`*^9, 4.000559140440842*^9}, {
