      RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"etaFromSigma", "[", 
    RowBox[{"s_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sqrt", "[", "2", "]"}], " ", "s"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sigmaFromEta", "[", 
     RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], " ", "x"}], ")"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zOpt", "[", "1", "]"}], "=", 
   RowBox[{"-", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"zOpt", "[", "2", "]"}], "=", "1"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"w", "[", 
     RowBox[{"z_", ",", "e_Integer", ",", "eta_"}], "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"eta", "^", "2"}]}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"z", "-", 
         RowBox[{"zOpt", "[", "e", "]"}]}], ")"}], "^", "2"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"transmissionMatrix", "[", 
     RowBox[{"beta1_", ",", "beta2_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"beta1", ",", 
        RowBox[{"1", "-", "beta1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "-", "beta2"}], ",", "beta2"}], "}"}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"selectionMatrix", "[", 
     RowBox[{"e_Integer", ",", "z1_", ",", "z2_", ",", "eta_"}], "]"}], ":=", 
    
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"w", "[", 
        RowBox[{"z1", ",", "e", ",", "eta"}], "]"}], ",", 
       RowBox[{"w", "[", 
        RowBox[{"z2", ",", "e", ",", "eta"}], "]"}]}], "}"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cycleMatrix", "[", 
     RowBox[{
     "z1_", ",", "z2_", ",", "beta1_", ",", "beta2_", ",", "eta_", ",", 
      "k_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"b", "=", 
         RowBox[{"transmissionMatrix", "[", 
          RowBox[{"beta1", ",", "beta2"}], "]"}]}], ",", "a1", ",", "a2"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"a1", "=", 
        RowBox[{
         RowBox[{"selectionMatrix", "[", 
          RowBox[{"1", ",", "z1", ",", "z2", ",", "eta"}], "]"}], ".", 
         "b"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"a2", "=", 
        RowBox[{
         RowBox[{"selectionMatrix", "[", 
          RowBox[{"2", ",", "z1", ",", "z2", ",", "eta"}], "]"}], ".", 
         "b"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"MatrixPower", "[", 
         RowBox[{"a1", ",", "k"}], "]"}], ".", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"a2", ",", "k"}], "]"}]}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dominantEigenvalue2", "[", "m_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Tr", "[", "m", "]"}], "+", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Tr", "[", "m", "]"}], "^", "2"}], "-", 
         RowBox[{"4", " ", 
          RowBox[{"Det", "[", "m", "]"}]}]}], "]"}]}], ")"}], "/", "2"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"lambdaExpression", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"lambdaExpression", "[", "k", "]"}], "=", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"dominantEigenvalue2", "[", 
        RowBox[{"cycleMatrix", "[", 
         RowBox[{
         "z1", ",", "z2", ",", "beta1", ",", "beta2", ",", "eta", ",", "k"}], 
         "]"}], "]"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "k"}], ")"}]}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gradientExpression", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"gradientExpression", "[", "k", "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"lambdaExpression", "[", "k", "]"}], ",", "#"}], "]"}], 
        "&"}], ")"}], "/@", 
      RowBox[{"{", 
       RowBox[{"z1", ",", "z2", ",", "beta1", ",", "beta2"}], "}"}]}]}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"secondZ2Expression", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"secondZ2Expression", "[", "k", "]"}], "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"lambdaExpression", "[", "k", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"z2", ",", "2"}], "}"}]}], "]"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"z1", "->", "0"}], ",", 
        RowBox[{"z2", "->", "0"}]}], "}"}]}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"lambdaCompiled", "[", "k_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"lambdaCompiled", "[", "k", "]"}], "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr", "=", 
         RowBox[{"lambdaExpression", "[", "k", "]"}]}], "}"}], ",", 
