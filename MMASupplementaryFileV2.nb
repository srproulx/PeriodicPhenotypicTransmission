            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"parameters", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "<", "0.1"}]}], ",", 
           RowBox[{"parameters", "=", 
            RowBox[{"N", "[", "noMemoryStartingParameters", "]"}]}]}], "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"etaValue", "=", 
          RowBox[{"Sqrt", "[", "etaSquared", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{"step", "<", "hysteresisMaximumSteps"}], ",", 
