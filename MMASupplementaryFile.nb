          RowBox[{"{", 
           RowBox[{"3", ",", "2.5`", ",", "2"}], "}"}], ",", "\"\<B\>\"", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", 
              RowBox[{"{", 
               RowBox[{"0.55`", ",", "0.93`"}], "}"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2.5`", ",", 
              RowBox[{"{", 
               RowBox[{"0.55`", ",", "0.73`"}], "}"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"3", ",", 
              RowBox[{"{", 
               RowBox[{"0.55`", ",", "0.63`"}], "}"}]}], "}"}]}], "}"}]}], 
         "]"}]}], "}"}], ",", 
      RowBox[{"Spacings", "\[Rule]", "10"}], ",", 
      RowBox[{"ImageSize", "\[Rule]", "850"}]}], "]"}]}], ";", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "outputDirectory", ",", "\"\<randomization_invasion_region.pdf\>\""}], 
       "}"}], "]"}], ",", "randomizationRegionFigure"}], "]"}], ";", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "outputDirectory", ",", "\"\<memory_invasion_regions.pdf\>\""}], "}"}],
       "]"}], ",", "memoryRegionFigure"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[684]:=",ExpressionUUID->"fa07dee9-68b6-41ba-9012-9895ca23330c"],

