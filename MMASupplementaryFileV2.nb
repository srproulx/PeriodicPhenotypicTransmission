Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "lambdaNumeric", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lambdaNumeric", "[", 
      RowBox[{"params_List", ",", 
       RowBox[{"etaValue_", "?", "NumericQ"}], ",", "k_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{"N", "[", "params", "]"}]}], ",", "b", ",", "a1", ",", "a2",
          ",", "m", ",", "scale", ",", "r"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"b", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"p", "[", 
              RowBox[{"[", "3", "]"}], "]"}], ",", 
             RowBox[{"1", "-", 
              RowBox[{"p", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "-", 
              RowBox[{"p", "[", 
               RowBox[{"[", "4", "]"}], "]"}]}], ",", 
             RowBox[{"p", "[", 
              RowBox[{"[", "4", "]"}], "]"}]}], "}"}]}], "}"}]}], ";", "\n", 
        "  ", 
        RowBox[{"a1", "=", 
         RowBox[{
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{"{", "\n", "    ", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"etaValue", "^", "2"}]}], "*", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"p", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], ")"}], "^", 
                "2"}]}], "]"}], ",", "\n", "    ", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"etaValue", "^", "2"}]}], "*", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"p", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "+", "1"}], ")"}], "^", 
                "2"}]}], "]"}]}], "\n", "  ", "}"}], "]"}], ".", "b"}]}], ";",
         "\n", "  ", 
        RowBox[{"a2", "=", 
         RowBox[{
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{"{", "\n", "    ", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"etaValue", "^", "2"}]}], "*", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"p", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ")"}], "^", 
                "2"}]}], "]"}], ",", "\n", "    ", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"etaValue", "^", "2"}]}], "*", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"p", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ")"}], "^", 
                "2"}]}], "]"}]}], "\n", "  ", "}"}], "]"}], ".", "b"}]}], ";",
         "\n", "  ", 
        RowBox[{"m", "=", 
         RowBox[{
          RowBox[{"MatrixPower", "[", 
           RowBox[{"a1", ",", "k"}], "]"}], ".", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{"a2", ",", "k"}], "]"}]}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"MatrixQ", "[", 
             RowBox[{"m", ",", "NumberQ"}], "]"}]}], "||", 
           RowBox[{
            RowBox[{"Dimensions", "[", "m", "]"}], "!=", 
            RowBox[{"{", 
             RowBox[{"2", ",", "2"}], "}"}]}]}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<S4 matrix calculation failed at k = \>\"", ",", "k", ",", 
             "\"\<; parameters = \>\"", ",", "p"}], "]"}], ";", "\n", "    ", 
           
           RowBox[{"Abort", "[", "]"}]}]}], "\n", "  ", "]"}], ";", "\n", 
        "  ", 
        RowBox[{"scale", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"Flatten", "[", "m", "]"}], "]"}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"scale", ">", "0."}], "]"}]}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<S4 matrix has invalid scale at k = \>\"", ",", "k", ",", 
             "\"\<; parameters = \>\"", ",", "p"}], "]"}], ";", "\n", "    ", 
           
           RowBox[{"Abort", "[", "]"}]}]}], "\n", "  ", "]"}], ";", "\n", 
        "  ", 
        RowBox[{"m", "=", 
         RowBox[{"m", "/", "scale"}]}], ";", "\n", "  ", 
        RowBox[{"r", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}], "+", "\n", "    ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"m", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}], "-", 
                 RowBox[{"m", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ")"}], "^", "2"}],
               "+", 
              RowBox[{"4", "*", 
               RowBox[{"m", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], "*", 
               RowBox[{"m", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "1"}], "]"}], "]"}]}]}], "]"}]}], ")"}], 
          "/", "2"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"r", ">", "0."}], "]"}]}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<S4 growth root is invalid at k = \>\"", ",", "k", ",", 
             "\"\<; parameters = \>\"", ",", "p"}], "]"}], ";", "\n", "    ", 
           
           RowBox[{"Abort", "[", "]"}]}]}], "\n", "  ", "]"}], ";", "\n", 
        "  ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Log", "[", "scale", "]"}], "+", 
           RowBox[{"Log", "[", "r", "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "k"}], ")"}]}]}]}], "\n", "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.00107073141361*^9, 4.0010707332013807`*^9}, 
   4.001070837190879*^9},ExpressionUUID->"6a57c2a1-e904-4b40-8681-\
10cd0510a6cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"selectionByK", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "kValue", "}"}], ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Transpose", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"params", "=", 
                 RowBox[{"{", 
                  RowBox[{"0.", ",", "0.10", ",", "0.99", ",", "0.01"}], 
                  "}"}]}], ",", "grad", ",", "d", ",", "plus", ",", "minus", 
                ",", "index", ",", "x", ",", 
                RowBox[{"step", "=", "0"}], ",", 
                RowBox[{"maximum", "=", "0."}]}], "}"}], ",", 
              RowBox[{
               RowBox[{"While", "[", 
                RowBox[{
                 RowBox[{"step", "<", "20000"}], ",", 
                 RowBox[{
                  RowBox[{"grad", "=", 
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"d", "=", 
                    RowBox[{"Min", "[", 
                    RowBox[{"1.*^-6", ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"j", "<=", "2"}], ",", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"params", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ")"}], "/", 
                    "8"}], ",", 
                    RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"params", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", 
                    RowBox[{"1", "-", 
                    RowBox[{"params", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}], "/", "4"}]}], 
                    "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"plus", "=", 
                    RowBox[{"minus", "=", "params"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"plus", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "+=", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"j", "<=", "2"}], ",", 
                    RowBox[{"2", "*", "d"}], ",", "d"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"minus", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "-=", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"j", "<=", "2"}], ",", 
                    RowBox[{"2", "*", "d"}], ",", "d"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{"lambdaNumeric", "[", 
                    RowBox[{"plus", ",", "etaValue", ",", "kValue"}], "]"}], 
                    "]"}], "-", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"lambdaNumeric", "[", 
                    RowBox[{"minus", ",", "etaValue", ",", "kValue"}], "]"}], 
                    "]"}]}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"2", "*", "d"}], ")"}]}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "4"}], "}"}]}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"maximum", "=", 
                   RowBox[{"Max", "[", 
                    RowBox[{"maximum", ",", 
                    RowBox[{"Norm", "[", "grad", "]"}]}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"Abs", "[", "grad", "]"}], "]"}], "<=", 
                    "1.*^-4"}], ",", 
                    RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"index", "=", 
                   RowBox[{"First", "[", 
                    RowBox[{"Ordering", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", "grad", "]"}], ",", 
                    RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"x", "=", 
                   RowBox[{
                    RowBox[{"Log", "[", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"index", "<=", "2"}], ",", 
                    RowBox[{"1", "+", 
                    RowBox[{"params", "[", 
                    RowBox[{"[", "index", "]"}], "]"}]}], ",", 
                    RowBox[{"params", "[", 
                    RowBox[{"[", "index", "]"}], "]"}]}], "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"params", "[", 
                    RowBox[{"[", "index", "]"}], "]"}]}], ")"}]}], "]"}], "+", 
                    RowBox[{"0.2", " ", 
                    RowBox[{"grad", "[", 
                    RowBox[{"[", "index", "]"}], "]"}]}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"params", "[", 
                    RowBox[{"[", "index", "]"}], "]"}], "=", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"index", "<=", "2"}], ",", 
                    RowBox[{
                    RowBox[{"2", "/", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"-", "x"}], "]"}]}], ")"}]}], "-", "1"}], ",", 
                    RowBox[{"1", "/", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"-", "x"}], "]"}]}], ")"}]}]}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"step", "++"}], ";"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"maximum", ",", "step"}], "}"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"etaValue", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"1", "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Sqrt", "[", "8", "]"}], "*", "0.45"}], ")"}]}], 
                ",", 
                RowBox[{"1", "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Sqrt", "[", "8", "]"}], "*", "0.25"}], ")"}]}]}], 
               "}"}]}], "}"}]}], "]"}], "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"kValue", ",", "2", ",", "52", ",", "5"}], "}"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"blueSelectionData", "=", 
   RowBox[{"selectionByK", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"redSelectionData", "=", 
   RowBox[{"selectionByK", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
