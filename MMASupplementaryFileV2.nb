Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"suppCurvature6", "=", 
    RowBox[{"Simplify", "[", "\n", "  ", 
     RowBox[{"compact", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h", "->", 
         RowBox[{"suppBeta1", "+", "suppBeta2", "-", "1"}]}], ",", "\n", 
        "    ", 
        RowBox[{"q2", "->", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "suppBeta1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", "-", "suppBeta1", "-", "suppBeta2"}], ")"}]}]}], ",", 
        
        RowBox[{"eta", "->", "1"}], ",", 
        RowBox[{"k", "->", "6"}]}], "}"}]}], "\n", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"suppCurvatureFigure", "=", 
    RowBox[{"Plot3D", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Evaluate", "[", "suppCurvature6", "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"suppBeta2", ",", "0.001", ",", "0.999"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"suppBeta1", ",", "0.001", ",", "0.999"}], "}"}], ",", "\n", 
      "  ", 
      RowBox[{"RegionFunction", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#3", ">", "0"}], "&"}], ")"}]}], ",", "\n", "  ", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], ",", "\n", "  ", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Beta]", ",", "2"}], "]"}], ",", "18", ",", "Bold"}], 
          "]"}], ",", "\n", "    ", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Beta]", ",", "1"}], "]"}], ",", "18", ",", "Bold"}], 
          "]"}], ",", "\n", "    ", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Superscript", "[", 
